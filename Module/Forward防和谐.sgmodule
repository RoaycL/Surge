#!name=Forward防和谐
#!desc=重新支持禁用Forward的Emby服务器

[MITM]
# 更新为新增目标域名（自动继承系统已有配置）
hostname = %APPEND% emby.pilipiliultra.com, emby-direct.pilipiliultra.com

[Script]
# 更新域名正则匹配
emby_modify = type=http-request,pattern=^https?://(emby\.pilipiliultra\.com|emby-direct\.pilipiliultra\.com|cc\.coemn\.com)(:\d+)?/emby/,requires-body=1,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/emby_modify.js

[Rule]
# 同步更新拦截域名
URL-REGEX,^https?://(emby\.pilipiliultra\.com|emby-direct\.pilipiliultra\.com)(:\d+)?/emby/System/Ping$,REJECT
