[MITM]
hostname = %APPEND% in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com

[Script]
fk-JD_Price-0 = type=http-request, pattern="(?i)^https?://apapia-sqk-weblogic\.manmanbuy\.com/baoliao/center/menu$", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/JD/JD_Price.js, timeout=10
fk-JD_Price-1 = type=http-response, pattern="(?i)^https?://in\.m\.jd\.com/product/graphext/\d+\.html", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/JD/JD_Price.js, timeout=10
