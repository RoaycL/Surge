#!name=Follow每日签到
#!desc=Follow每日签到，需要进入此插件的主页链接，阅读使用说明操作。
#!author=gideonsenku[https://github.com/gideonsenku], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=功能增强
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/FollowRSS.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/FollowRSS_checkin.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
#!arguments=token:,cookie:,cron:0 1 * * *
#!arguments-desc=token=；tag=csrfToken,desc=这里需要输入csrfToken的值 | cookie=；tag=Cookie,desc=这里需要输入Cookie的值 | cron=0 1 * * *；tag=定时参数,desc=这里需要输入符合CRON表达式的参数

[MITM]
hostname = %APPEND% api.follow.is

[Script]
fk-FollowRSS_checkin-0 = type=cron, cronexp="{{{cron}}}", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/FollowRSS/FollowRSS_checkin.js, timeout=120, argument="token={{{token}}}&cookie={{{cookie}}}"
