#!arguments=cron:55 23 * * *
#!arguments-desc=cron=55 23 * * *；tag=定时参数,desc=这里需要输入符合CRON表达式的参数
# NOTE: 主配置需添加：RULE-SET,https://raw.githubusercontent.com/RoaycL/Surge/main/Ruleset/Enhancement/Sub-Store.list,节点选择（替换为你的代理策略）。

[MITM]
hostname = %APPEND% sub.store

[Script]
fk-Sub-Store-0 = type=http-request, pattern="(?i)^https?://sub\.store/((download)|api/(preview|sync|(utils/node-info)))", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-1.min.js, timeout=120
fk-Sub-Store-1 = type=http-request, pattern="(?i)^https?://sub\.store", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-0.min.js, timeout=120
fk-Sub-Store-2 = type=cron, cronexp="{{{cron}}}", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/github.com/sub-store-org/Sub-Store/releases/latest/download/cron-sync-artifacts.min.js, timeout=120
