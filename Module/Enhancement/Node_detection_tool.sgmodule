#!name=节点检测工具
#!desc=适用于Loon的节点检测工具，可进行地理位置、节点解锁、入口落地等查询。请在所有节点页面选择一个节点长按，出现菜单后进行测试。
#!author=xream[https://github.com/xream], Keywos[https://github.com/Keywos], KOP-XIAO[https://github.com/KOP-XIAO], dcpengx[https://github.com/dcpengx]
#!category=功能增强
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/Node_detection_tool.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Node_detection_tool.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
#!arguments=policy:DIRECT
#!arguments-desc=policy：Surge 节点/策略名称，替代 Loon 长按节点。

[Script]
fk-Node_detection_tool-0 = type=generic, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Node_detection_tool/NetworkEntryAndExitQueries.js, timeout=10, argument="__policy={{{policy}}}"
fk-Node_detection_tool-1 = type=generic, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Node_detection_tool/LocationDetection.js, timeout=10, argument="__policy={{{policy}}}"
fk-Node_detection_tool-2 = type=generic, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Node_detection_tool/NodeUnlockDetection.js, timeout=20, argument="__policy={{{policy}}}"

[Panel]
节点检测工具-0 = script-name=fk-Node_detection_tool-0,update-interval=-1
节点检测工具-1 = script-name=fk-Node_detection_tool-1,update-interval=-1
节点检测工具-2 = script-name=fk-Node_detection_tool-2,update-interval=-1
