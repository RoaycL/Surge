#!name=Apple天气增强
#!desc=解锁Apple天气的全部功能、替换空气质量数据源、添加下一小时降水数据、添加天气数据。
#!author=VirgilClyne[https://github.com/VirgilClyne], WordlessEcho[https://github.com/WordlessEcho], 001[https://github.com/001ProMax]
#!category=功能增强
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/AppleWeather.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/AppleWeatherEnhancer.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
#!arguments=Weather_Provider:ColorfulClouds,NextHour_Provider:ColorfulClouds,AirQuality_Calculate_Algorithm:EU_EAQI,API_ColorfulClouds_Token:,API_QWeather_Host:devapi.qweather.com,API_QWeather_Token:,API_WAQI_Token:,Storage:Argument,LogLevel:WARN
#!arguments-desc=Weather.Provider=ColorfulClouds；"WeatherKit","QWeather",tag=[天气]数据源,desc=使用选定的数据源替换天气数据。 | NextHour.Provider=ColorfulClouds；"WeatherKit","QWeather",tag=[未来一小时降水强度]数据源,desc=使用选定的数据源填充未来一小时降水强度的数据。 | AirQuality.Calculate.Algorithm=EU_EAQI；"None","UBA","WAQI_InstantCast_US","WAQI_InstantCast_CN","WAQI_InstantCast_CN_25_DRAFT",tag=AQI算法,desc=使用内置算法，通过污染物数据本地计算空气指数。InstantCast源自于WAQI，美标版本使用了WAQI的臭氧标准。 | API.ColorfulClouds.Token=；tag=[API]彩云天气令牌,desc=彩云天气API令牌 | API.QWeather.Host=devapi.qweather.com；tag=[API]和风天气主机,desc=和风天气API使用的主机名 | API.QWeather.Token=；tag=[API]和风天气令牌,desc=和风天气API令牌 | API.WAQI.Token=；tag=[API]WAQI令牌,desc=WAQI API令牌，填写此字段将自动使用WAQI高级API | Storage=Argument；"PersistentStore","database",tag=[储存]配置类型,desc=选择要使用的配置类型。未设置此选项或不通过此选项的旧版本的配置顺序依旧是$persistentStore (BoxJs) > $argument > database。 | LogLevel=WARN；"OFF","ERROR","INFO","DEBUG","ALL",tag=[调试]日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rule]
DOMAIN, weather-analytics-events.apple.com, REJECT-DROP
DOMAIN, tether.edge.apple, REJECT-DROP
DOMAIN-SUFFIX, tthr.apple.com, REJECT-DROP
AND, ((OR, ((IP-ASN, 714, no-resolve), (IP-ASN, 6185, no-resolve))), (PROTOCOL, QUIC)), REJECT-DROP

[MITM]
hostname = %APPEND% weatherkit.apple.com

[Script]
fk-AppleWeatherEnhancer-0 = type=http-response, pattern="(?i)^https?://weatherkit\.apple\.com/api/v1/availability/", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/github.com/NSRingo/WeatherKit/releases/download/v3.1.0/response.bundle.js, timeout=15, argument="Weather.Provider={{{Weather_Provider}}}&NextHour.Provider={{{NextHour_Provider}}}&AirQuality.Calculate.Algorithm={{{AirQuality_Calculate_Algorithm}}}&API.ColorfulClouds.Token={{{API_ColorfulClouds_Token}}}&API.QWeather.Host={{{API_QWeather_Host}}}&API.QWeather.Token={{{API_QWeather_Token}}}&API.WAQI.Token={{{API_WAQI_Token}}}&Storage={{{Storage}}}&LogLevel={{{LogLevel}}}"
fk-AppleWeatherEnhancer-1 = type=http-response, pattern="(?i)^https?://weatherkit\.apple\.com/api/v2/weather/", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/github.com/NSRingo/WeatherKit/releases/download/v3.1.0/response.bundle.js, timeout=15, argument="Weather.Provider={{{Weather_Provider}}}&NextHour.Provider={{{NextHour_Provider}}}&AirQuality.Calculate.Algorithm={{{AirQuality_Calculate_Algorithm}}}&API.ColorfulClouds.Token={{{API_ColorfulClouds_Token}}}&API.QWeather.Host={{{API_QWeather_Host}}}&API.QWeather.Token={{{API_QWeather_Token}}}&API.WAQI.Token={{{API_WAQI_Token}}}&Storage={{{Storage}}}&LogLevel={{{LogLevel}}}"
