#!name=VVebo时间线修复
#!desc=修复失效的用户时间线和我的页面。使用此插件前需要禁用微博去广告插件，避免插件冲突导致失效。
#!author=suiyuran[https://github.com/suiyuran], androidcn[https://github.com/androidcn]
#!category=功能增强
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/VVebo.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/VVebo_repair.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% api.weibo.cn

[Script]
fk-VVebo_repair-0 = type=http-request, pattern="(?i)^https://api\.weibo\.cn/2/users/show\?", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/VVebo/VVebo_repair.js, timeout=15
fk-VVebo_repair-1 = type=http-request, pattern="(?i)^https://api\.weibo\.cn/2/statuses/user_timeline\?", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/VVebo/VVebo_repair.js, timeout=15
fk-VVebo_repair-2 = type=http-request, pattern="(?i)^https://api\.weibo\.cn/2/remind/unread_count\?", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/VVebo/VVebo_repair.js, timeout=15
fk-VVebo_repair-3 = type=http-response, pattern="(?i)^https://api\.weibo\.cn/2/profile/statuses/tab\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/VVebo/VVebo_repair.js, timeout=15
fk-VVebo_repair-4 = type=http-response, pattern="(?i)^https://api\.weibo\.cn/2/cardlist\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/VVebo/VVebo_repair.js, timeout=15
