# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/TestFlightRegionUnlock.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
# NOTE: 主配置需添加：RULE-SET,https://raw.githubusercontent.com/RoaycL/Surge/main/Ruleset/Enhancement/TestFlightRegionUnlock.list,节点选择（替换为你的代理策略）。

[MITM]
hostname = %APPEND% testflight.apple.com

[Script]
fk-TestFlightRegionUnlock-rewrite-request = type=http-request, pattern="(?:(?i)^https?://testflight\.apple\.com/v\d/accounts/.+?/install$)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/TestFlightRegionUnlock-request.js, timeout=10
