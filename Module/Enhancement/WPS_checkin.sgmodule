#!name=WPS每日签到
#!desc=WPS每日签到并兑换会员，需要进入此插件的主页链接，阅读使用说明操作。
#!author=小白脸
#!category=功能增强
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/WPS.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/WPS_checkin.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
#!arguments=CaptureCookie:false,AK:,SK:,DAY:1,MAX_RETRIES:5,CRONEXP:0 8 * * *
#!arguments-desc=CaptureCookie=False；true,tag=捕获Cookie,desc=此开关控制插件是否捕获Cookie | AK=；tag=百度API Key,desc=这里需要输入有效的百度API Key | SK=；tag=百度Secret Key,desc=这里需要输入有效的百度Secret Key | DAY=1；tag=兑换天数,desc=每日签到时自动兑换的天数，可不做更改。 | MAX_RETRIES=5；tag=失败重试次数,desc=仅允许填写阿拉伯数字 | CRONEXP=0 8 * * *；tag=定时参数,desc=这里需要输入符合CRON表达式的参数

[MITM]
hostname = %APPEND% moapi.wps.cn

[Script]
fk-WPS_checkin-0 = type=http-request, pattern="(?i)^https://moapi\.wps\.cn/app/ios/v1/app$", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/WPS/WPS_checkin.js, timeout=15, argument="__enable={{{CaptureCookie}}}"
fk-WPS_checkin-1 = type=cron, cronexp="{{{CRONEXP}}}", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/WPS/WPS_checkin.js, timeout=120, argument="AK={{{AK}}}&SK={{{SK}}}&MAX_RETRIES={{{MAX_RETRIES}}}"
