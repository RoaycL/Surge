[MITM]
hostname = %APPEND% boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net

[Script]
fk-BoxJs-0 = type=http-request, pattern="(?i)^https?://(.+\.)?boxjs\.(com|net)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/raw.githubusercontent.com/chavyleung/scripts/master/box/chavy.boxjs.js, timeout=120
