#!name=自动加入TestFlight
#!desc=自动监控TestFlight名额，一旦有新的名额即刻加入。
#!author=奶思[https://github.com/fmz200], DecoAri[https://github.com/DecoAri], xream[https://github.com/xream]
#!category=功能增强
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TestFlight.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Auto_Join_TF.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
#!arguments=CaptureAccountToken:false,RunTask:false,RunMonitor:true,TaskCron:0 0/2 * * * *,TaskMonitor:0 * * * * *,App_ID:
#!arguments-desc=CaptureAccountToken=False；true,tag=捕获账号令牌,desc=此开关控制插件是否捕获账户令牌 | RunTask=false；"true",tag=自动加入TF,desc=此开关控制是否启动定时任务 | RunMonitor=true；"false",tag=监控TF位置,desc=此开关控制是否启动定时任务 | TaskCron=0 0/2 * * * *；tag=加入TF定时参数,desc=这里需要输入符合CRON表达式的参数 | TaskMonitor=0 * * * * *；tag=监控TF定时参数,desc=这里需要输入符合CRON表达式的参数 | App_ID：TestFlight ID，可用逗号分隔；修改后同步到原脚本存储，脚本自动移除已加入 ID 的行为保留。
# NOTE: 主配置需添加：RULE-SET,https://raw.githubusercontent.com/RoaycL/Surge/main/Ruleset/Enhancement/Auto_Join_TF.list,节点选择（替换为你的代理策略）。

[Script]
fk-Auto_Join_TF-0 = type=http-request, pattern="(?i)^https?://testflight\.apple\.com/v3/accounts/.*/apps$", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/TestFlight/CaptureAccountToken.js, timeout=15, argument="__enable={{{CaptureAccountToken}}}&__store_App_ID={{{App_ID}}}"
fk-Auto_Join_TF-1 = type=cron, cronexp="{{{TaskCron}}}", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/TestFlight/AutoJoinTF.js, timeout=600, argument="__enable={{{RunTask}}}&__store_App_ID={{{App_ID}}}"
fk-Auto_Join_TF-2 = type=cron, cronexp="{{{TaskMonitor}}}", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/TestFlight/AutoMonitorTF.js, timeout=30, argument="__enable={{{RunMonitor}}}&__store_App_ID={{{App_ID}}}"
