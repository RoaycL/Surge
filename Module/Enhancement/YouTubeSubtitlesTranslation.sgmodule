#!name=YouTube双语翻译
#!desc=字幕增强及双语翻译，支持Youtube Music歌词翻译。此插件需要置于YouTube去广告插件之下，且和YouTube去广告插件的歌词翻译冲突，不支持tvOS设备。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!category=功能增强
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
#!date=2026-10-02 13:57:49
#!arguments=Type:Official,AutoCC:true,ShowOnly:true,Position:Forward
#!arguments-desc=字幕类型（Type）：请选择要使用的字幕，双语字幕将使用您选择类型呈现。默认 Official，可选 Official / Translate\n自动显示翻译字幕（AutoCC）：开启后总是自动开启显示字幕。默认 true，可选 true / false\n仅显示“自动翻译”字幕（ShowOnly）：开启后仅显示“自动翻译”后的字幕，不显原文字幕。默认 true，可选 true / false\n原文字幕位置（Position）：原文字幕的显示位置。默认 Forward，可选 Forward / Reverse
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/YouTubeSubtitlesTranslation.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com

[Script]
fk-YouTubeSubtitlesTranslation-0 = type=http-request, pattern="(?i)^https?://(www|m|tv)\.youtube\.com/youtubei/v1/player\?(.*)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_request.js, timeout=15, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}"
fk-YouTubeSubtitlesTranslation-1 = type=http-response, pattern="(?i)^https?://(www|m|tv)\.youtube\.com/youtubei/v1/player\?(.*)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_response.js, timeout=15, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}"
fk-YouTubeSubtitlesTranslation-2 = type=http-request, pattern="(?i)^https?://youtubei\.googleapis\.com/youtubei/v1/player\?(.*)", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_request.js, timeout=15, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}"
fk-YouTubeSubtitlesTranslation-3 = type=http-response, pattern="(?i)^https?://youtubei\.googleapis\.com/youtubei/v1/player\?(.*)", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_response.js, timeout=15, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}"
fk-YouTubeSubtitlesTranslation-4 = type=http-response, pattern="(?i)^https?://youtubei\.googleapis\.com/youtubei/v1/get_watch\?(.*)", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_response.js, timeout=15, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}"
fk-YouTubeSubtitlesTranslation-5 = type=http-request, pattern="(?i)^https?://(www|m)\.youtube\.com/api/timedtext\?(.*)", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_request.js, timeout=15, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}"
fk-YouTubeSubtitlesTranslation-6 = type=http-response, pattern="(?i)^https?://(www|m)\.youtube\.com/api/timedtext\?(.*)subtype=(Official|External)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Composite_Subtitles_response.js, timeout=15
fk-YouTubeSubtitlesTranslation-7 = type=http-response, pattern="(?i)^https?://(www|m)\.youtube\.com/api/timedtext\?(.*)subtype=Translate", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_Translate_response.js, timeout=15
fk-YouTubeSubtitlesTranslation-8 = type=http-request, pattern="(?i)^https?://music\.youtube\.com/youtubei/v1/browse\?(.*)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_request.js, timeout=15, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}"
fk-YouTubeSubtitlesTranslation-9 = type=http-request, pattern="(?i)^https?://youtubei\.googleapis\.com/youtubei/v1/browse\?(.*)", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_request.js, timeout=15, argument="Type={{{Type}}}&AutoCC={{{AutoCC}}}&ShowOnly={{{ShowOnly}}}&Position={{{Position}}}"
fk-YouTubeSubtitlesTranslation-10 = type=http-response, pattern="(?i)^https?://music\.youtube\.com/youtubei/v1/browse\?(.*)subtype=Translate", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_Translate_response.js, timeout=15
fk-YouTubeSubtitlesTranslation-11 = type=http-response, pattern="(?i)^https?://youtubei\.googleapis\.com/youtubei/v1/browse\?(.*)subtype=Translate", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_Subtitles_Translate/YouTube_Subtitles_Translate_response.js, timeout=15
