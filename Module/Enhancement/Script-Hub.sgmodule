#!name=Script-Hub
#!desc=将其他工具的Rewrite、Rule和JavaScript资源转换为Loon能识别的格式，使用前请在本插件的详情页面为[PROXY]项分配代理策略。在插件列表中点击此插件上的链接查看使用方法。
#!author=xream[https://github.com/xream], Keywos[https://github.com/Keywos], CKYB[https://github.com/CKYB], 小白脸
#!category=功能增强
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/Script-Hub.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Script-Hub.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
#!arguments=ScriptHubNotify:%E8%B7%9F%E9%9A%8F%E9%93%BE%E6%8E%A5,Parser_body_max:,Parser_http_timeout:20
#!arguments-desc=ScriptHubNotify：开启通知 / 关闭通知 / 跟随链接 | Parser_body_max：最大响应体参数，留空使用上游默认值 | Parser_http_timeout：请求超时秒数，默认20
# NOTE: 主配置需添加：RULE-SET,https://raw.githubusercontent.com/RoaycL/Surge/main/Ruleset/Enhancement/Script-Hub.list,节点选择（替换为你的代理策略）。

[MITM]
hostname = %APPEND% script.hub, *.script.hub

[Script]
fk-Script-Hub-0 = type=http-request, pattern="(?i)^https?://script\.hub/($|edit/|reload)", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-hub.js, timeout=300, argument="__store_ScriptHub通知={{{ScriptHubNotify}}}&__store_Parser_body_max={{{Parser_body_max}}}&__store_Parser_http_timeout={{{Parser_http_timeout}}}"
fk-Script-Hub-1 = type=http-request, pattern="(?i)^https?://script\.hub/file/_start_/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module)", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/Rewrite-Parser.js, timeout=300, argument="__store_ScriptHub通知={{{ScriptHubNotify}}}&__store_Parser_body_max={{{Parser_body_max}}}&__store_Parser_http_timeout={{{Parser_http_timeout}}}"
fk-Script-Hub-2 = type=http-request, pattern="(?i)^https?://script\.hub/file/_start_/.+type=rule-set", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/rule-parser.js, timeout=300, argument="__store_ScriptHub通知={{{ScriptHubNotify}}}&__store_Parser_body_max={{{Parser_body_max}}}&__store_Parser_http_timeout={{{Parser_http_timeout}}}"
fk-Script-Hub-3 = type=http-request, pattern="(?i)^https?://script\.hub/convert/", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-converter.js, timeout=300, argument="__store_ScriptHub通知={{{ScriptHubNotify}}}&__store_Parser_body_max={{{Parser_body_max}}}&__store_Parser_http_timeout={{{Parser_http_timeout}}}"
