#!name=VMISS 流量概况
#!desc=在 Surge Panel 中显示 VMISS 流量。将「获取Cookie」设为 true 后，打开一次产品详情页即可更新产品 ID 与登录凭证。
#!arguments=获取Cookie:false,刷新间隔:300
#!arguments-desc=获取Cookie:是否在打开 VMISS 产品详情页时更新登录凭证；仅需更新时设为 true，更新后请改回 false。\n\n刷新间隔:刷新间隔（秒）

[Panel]
VMISS 流量 = title="VMISS 流量",content="首次请打开 VMISS 产品页面抓取登录凭证",style=info,script-name=vmiss-traffic,update-interval={{{刷新间隔}}}

[Script]
vmiss-traffic-capture = type=http-request,pattern=^https:\/\/app\.vmiss\.com\/clientarea\.php\?action=productdetails&id=\d+.*$,requires-body=0,max-size=0,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/Module/VMISSTraffic/vmiss-traffic.js?v=9,script-update-interval=300,argument="mode=capture&capture={{{获取Cookie}}}"
vmiss-traffic = type=generic,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/Module/VMISSTraffic/vmiss-traffic.js?v=9,timeout=15,script-update-interval=300,argument="mode=panel"

[MITM]
hostname = %APPEND% app.vmiss.com
