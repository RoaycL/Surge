#!name=VMISS 流量概况
#!desc=在 Surge Panel 中显示指定 VMISS 产品的实时流量使用情况。首次启用时填写账号、密码与产品 ID。
#!arguments=username=&password=&product_id=180263&update_interval=300

[Panel]
VMISS 流量 = title="VMISS 流量",content="点击刷新以获取流量数据",style=info,script-name=vmiss-traffic,update-interval=%update_interval%

[Script]
vmiss-traffic = type=generic,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/Module/VMISSTraffic/vmiss-traffic.js,timeout=15,script-update-interval=300,argument=username=%username%&password=%password%&product_id=%product_id%
