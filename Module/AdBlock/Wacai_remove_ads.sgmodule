[MITM]
hostname = %APPEND% jz.wacaijizhang.com

[Map Local]
(?i)^https://jz\.wacaijizhang\.com/api/banners/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://jz\.wacaijizhang\.com/api/resource/universal/fetch$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://jz\.wacaijizhang\.com/activity/ data-type=text data="" status-code=404 header="Content-Type:text/plain"

[Script]
fk-Wacai_remove_ads-rewrite-response = type=http-response, pattern="(?:(?i)^https://jz\.wacaijizhang\.com/sensor/config/iOS\.conf\?)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/Wacai_remove_ads-response.js, timeout=10
