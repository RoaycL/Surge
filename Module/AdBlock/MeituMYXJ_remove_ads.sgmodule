#!name=美颜相机去广告
#!desc=移除开屏广告、应用内弹窗，精简首页和我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MeituMYXJ.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/MeituMYXJ_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, adui.tg.meitu.com, REJECT

[MITM]
hostname = %APPEND% api.meiyan.com

[Map Local]
(?i)^https://api\.meiyan\.com/operation/home_banner\.json\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.meiyan\.com/vip/permission_update_popup\.json\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://api\.meiyan\.com/operation/get_config\.json\? 'reduce [["response","time_limit"],["response","bubble"],["response","person_center"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://api\.meiyan\.com/operation/get_config\.json\? '(if try (getpath(["response","function_pop","meiyan_style"]) | has("is_pop")) catch false then setpath(["response","function_pop","meiyan_style","is_pop"];false) else . end) | (if try (getpath(["response","onoff","vip_half_window_exit_remain_popup"]) | has("open")) catch false then setpath(["response","onoff","vip_half_window_exit_remain_popup","open"];0) else . end) | (if try (getpath(["response","onoff"]) | has("vip_home_exit_remain_popup")) catch false then setpath(["response","onoff","vip_home_exit_remain_popup"];0) else . end)'

[Script]
fk-MeituMYXJ_remove_ads-0 = type=http-response, pattern="(?i)^https://api\.meiyan\.com/operation/home\.json\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/MeituMYXJ/MeituMYXJ_remove_ads.js, timeout=15
