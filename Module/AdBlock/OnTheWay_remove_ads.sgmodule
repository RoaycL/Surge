#!name=行者户外去广告
#!desc=移除弹窗广告、发现页面横幅推广的推广金刚位，移除我的页面横幅推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/OnTheWay.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/OnTheWay_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% www.imxingzhe.com

[Map Local]
(?i)^https://www\.imxingzhe\.com/api/v1/pop/window/\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://www\.imxingzhe\.com/api/v4/account/get_user_info\? 'reduce [["banner"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://www\.imxingzhe\.com/api/v4/discovery/ios/\? 'reduce [["banners"],["ad"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://www\.imxingzhe\.com/api/v4/discovery/ios/\? '.display_areas |= map(select(.name == "赛事" or .name == "行者帮" or .name == "头条" or .name == "排行榜" or .name == "约伴"))'
