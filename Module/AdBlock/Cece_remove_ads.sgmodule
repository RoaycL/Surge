# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% api.cece.com

[Body Rewrite]
http-response-jq (?i)^https://api\.cece\.com/user/init\? 'reduce [["data","launch_img_url"],["data","launch_goto_url"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://api\.cece\.com/common/app/app_config\? '(if try (getpath(["data"]) | has("is_new_year")) catch false then setpath(["data","is_new_year"];false) else . end) | (if try (getpath(["data"]) | has("spring_festival")) catch false then setpath(["data","spring_festival"];false) else . end) | (if try (getpath(["data"]) | has("show_feedback_entry")) catch false then setpath(["data","show_feedback_entry"];false) else . end) | (if try (getpath(["data"]) | has("show_course_entry")) catch false then setpath(["data","show_course_entry"];false) else . end) | (if try (getpath(["data"]) | has("show_store_entry")) catch false then setpath(["data","show_store_entry"];false) else . end) | (if try (getpath(["data"]) | has("show_luna")) catch false then setpath(["data","show_luna"];false) else . end) | (if try (getpath(["data"]) | has("show_ead")) catch false then setpath(["data","show_ead"];false) else . end) | (if try (getpath(["data"]) | has("show_ad")) catch false then setpath(["data","show_ad"];false) else . end) | (if try (getpath(["data"]) | has("show_live_filter_tarot")) catch false then setpath(["data","show_live_filter_tarot"];false) else . end) | (if try (getpath(["data"]) | has("community_feed_adswitch")) catch false then setpath(["data","community_feed_adswitch"];false) else . end) | (if try (getpath(["data"]) | has("open_screen_ad_times")) catch false then setpath(["data","open_screen_ad_times"];0) else . end) | (if try (getpath(["data"]) | has("open_screen_ad_duration")) catch false then setpath(["data","open_screen_ad_duration"];0) else . end) | (if try (getpath(["data"]) | has("isShowThumbsGif")) catch false then setpath(["data","isShowThumbsGif"];false) else . end) | (if try (getpath(["data"]) | has("teenager_mode_open")) catch false then setpath(["data","teenager_mode_open"];false) else . end) | (if try (getpath(["data"]) | has("flu_log")) catch false then setpath(["data","flu_log"];false) else . end)'
http-response-jq (?i)^https://api\.cece\.com/common/app/app_config\? 'reduce [["data","activity_list"],["data","fortune_ab_config"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://api\.cece\.com/chart/tools/home_10_tools\? '.data.tools |= map(del(.icon_tip_image))'
http-response-jq (?i)^https://api\.cece\.com/user/index/tab_list\? '.data.tabs |= map(select(.type != "shop"))'
http-response-jq (?i)^https://api\.cece\.com/common/app/risk_entrance\? '(if try (getpath(["data"]) | has("ai_fortune_show_ask_tool")) catch false then setpath(["data","ai_fortune_show_ask_tool"];false) else . end) | (if try (getpath(["data"]) | has("ai_sign_show_ask_tool")) catch false then setpath(["data","ai_sign_show_ask_tool"];false) else . end) | (if try (getpath(["data"]) | has("single_tool_show_dice_card")) catch false then setpath(["data","single_tool_show_dice_card"];false) else . end) | (if try (getpath(["data"]) | has("single_tool_show_tarot_card")) catch false then setpath(["data","single_tool_show_tarot_card"];false) else . end) | (if try (getpath(["data"]) | has("single_tool_show_bazi_card")) catch false then setpath(["data","single_tool_show_bazi_card"];false) else . end) | (if try (getpath(["data"]) | has("single_tool_show_hepan_card")) catch false then setpath(["data","single_tool_show_hepan_card"];false) else . end) | (if try (getpath(["data"]) | has("single_tool_show_ziwei_card")) catch false then setpath(["data","single_tool_show_ziwei_card"];false) else . end) | (if try (getpath(["data"]) | has("single_tool_show_xingpan_card")) catch false then setpath(["data","single_tool_show_xingpan_card"];false) else . end) | (if try (getpath(["data"]) | has("multi_tool_show_card")) catch false then setpath(["data","multi_tool_show_card"];false) else . end) | (if try (getpath(["data"]) | has("ai_ccai_show_multi_tool")) catch false then setpath(["data","ai_ccai_show_multi_tool"];false) else . end)'

[Map Local]
(?i)^https://api\.cece\.com/user/index/banners\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.cece\.com/ask/ai_chat/popup\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.cece\.com/user/popup/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.cece\.com/chart/easter_egg/popup\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.cece\.com/user/register_task/notice_task\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.cece\.com/ask/ask/alert_minus\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.cece\.com/msgAsk/question/new_coupon_status\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.cece\.com/user/user/myPageBanner\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.cece\.com/live/recommend/new_user\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.cece\.com/chart/tools/get_search_recommend\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.cece\.com/user/rank/list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.cece\.com/chart/config/chart_activity\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-Cece_remove_ads-rewrite-response = type=http-response, pattern="(?:(?i)^https://api\.cece\.com/live/user/coupon_tab\?)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/Cece_remove_ads-response.js, timeout=10
