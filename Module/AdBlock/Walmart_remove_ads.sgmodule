#!name=沃尔玛去广告
#!desc=移除操作引导、商品详情页用户调研、搜索填充词和搜索发现，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Walmart.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Walmart_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% api-hyper.walmartmobile.cn

[Map Local]
(?i)^https://api-hyper\.walmartmobile\.cn/search/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-hyper\.walmartmobile\.cn/cms-web/frontapi/shadedWords/list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-hyper\.walmartmobile\.cn/search/frontapi/discovery-words/list$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://api-hyper\.walmartmobile\.cn/cms-web/frontapi/common/page/get\?.*&type=26$ '.data |= (.moduleList | map(select(.templateCode == "nav-bar-title" or .templateCode == "member-info" or .templateCode == "distribution-center" or .templateCode == "wallet" or .templateCode == "swiper" or .templateCode == "my-order")))'
