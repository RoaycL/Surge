#!name=微脉圈去广告
#!desc=移除开屏广告、聊天页横幅提示及发现页面的横幅广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weimai.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Weimai_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% confssl*.iweimai.cn

[Body Rewrite]
http-response-jq (?i)^https://confssl\d?\.iweimai\.cn/wm_ios_update\.json\? '(if try (getpath([]) | has("isShowCJAd")) catch false then setpath(["isShowCJAd"];0) else . end)'
http-response-jq (?i)^https://confssl\d?\.iweimai\.cn/wm_ios_update\.json\? 'reduce [["launchAd"],["adBanners"],["ad"]][] as $p (.; delpaths([$p]))'
