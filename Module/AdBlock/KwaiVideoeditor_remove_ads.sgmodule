[MITM]
hostname = %APPEND% api.kmovie.gifshow.com

[Map Local]
(?i)^https://api\.kmovie\.gifshow\.com/rest/n/kmovie/app/resource/get\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.kmovie\.gifshow\.com/rest/n/kmovie/app/banner/common/getBannerByType\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.kmovie\.gifshow\.com/rest/n/kmovie/app/merchant/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.kmovie\.gifshow\.com/rest/n/kmovie/app/resource/activity/pendant\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://api\.kmovie\.gifshow\.com/rest/n/kmovie/app/banner/common/getBannerByTypeV2\? 'del(.list[] | select(.bannerChannelName == "活动"))'
http-response-jq (?i)^https://api\.kmovie\.gifshow\.com/rest/n/kmovie/app/banner/common/getAllBannerPage\? 'del(.data[] | select(.bannerChannelName == "活动"))'
