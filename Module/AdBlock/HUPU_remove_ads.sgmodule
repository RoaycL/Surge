[MITM]
hostname = %APPEND% games.mobileapi.hupu.com, fairy.mobileapi.hupu.com, bbs.mobileapi.hupu.com, goblin.hupu.com

[Map Local]
(?i)^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bplapi/reddot/v1/app/getReddot data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bbs\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/(bbsallapi/tag/v1/heatTag|bbsrankapi/v1/rating/list) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/search/v2/(hintkeylist|hotkeylist) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://goblin\.hupu\.com/\d/\d\.\d\.\d+/interfaceAd/getOther/v\d data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://goblin\.hupu\.com/\d/\d\.\d\.\d+/interfaceAd/getOther/batch data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://fairy\.mobileapi\.hupu\.com/gallery/getmod2 data-type=text data="" status-code=200 header="Content-Type:text/plain"
(?i)^https://games\.mobileapi\.hupu\.com/3/8\.0\.86/bplcommentapi/bpl/score_tab/groups data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://games\.mobileapi\.hupu\.com/3/8\.0\.86/bplapi/banner/getLocationBanners data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-HUPU_remove_ads-0 = type=http-response, pattern="(?i)^https://fairy\.mobileapi\.hupu\.com/mang/preview/banners", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/HUPU/HUPU_remove_ads.js, timeout=15
fk-HUPU_remove_ads-1 = type=http-response, pattern="(?i)^https://bbs\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bbsallapi/lego/data", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/HUPU/HUPU_remove_ads.js, timeout=15
fk-HUPU_remove_ads-2 = type=http-response, pattern="(?i)^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/buffer/hotList", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/HUPU/HUPU_remove_ads.js, timeout=15
fk-HUPU_remove_ads-3 = type=http-response, pattern="(?i)^https://games\.mobileapi\.hupu\.com/\d/\d\.\d\.\d+/bplapi/user/v1/more", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/HUPU/HUPU_remove_ads.js, timeout=15
