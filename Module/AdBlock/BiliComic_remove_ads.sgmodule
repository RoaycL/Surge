[Script]
fk-BiliComic_remove_ads-0 = type=http-response, pattern="(?i)^https://manga\.bilibili\.com/twirp/comic\.v\d\.Comic/GetClassPageAllTabs", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/BiliComic/BiliComic_remove_ads.js, timeout=15
