# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Yitian_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% m2u-api.getkwai.com, api-m2u.kuaishou.com

[Map Local]
(?i)^https://(m2u-api\.getkwai|api-m2u\.kuaishou)\.com/api-server/api/v1/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(m2u-api\.getkwai|api-m2u\.kuaishou)\.com/api-server/api/v4/op/actPositions\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://(m2u-api\.getkwai|api-m2u\.kuaishou)\.com/api-server/api/v1/system/configs\? 'reduce [["data","shouldUseLMAdFirst"],["data","incentiveCfgList"]][] as $p (.; delpaths([$p]))'
