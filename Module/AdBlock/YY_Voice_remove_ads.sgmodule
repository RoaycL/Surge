#!name=YY去广告
#!desc=移除开屏广告、应用内弹窗，精简底栏和我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YY_Voice.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/YY_Voice_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, splash.yy.com, REJECT
DOMAIN, dsp-ad.yy.com, REJECT
DOMAIN, ysad.yy.com, REJECT

[MITM]
hostname = %APPEND% yyapp-act-entrance.yy.com, yyapp-fastnet.yy.com, personal-center.yy.com, tab.yy.com, data.3g.yy.com, yyapp-idx.yy.com

[Map Local]
(?i)^https://yyapp-fastnet\.yy\.com/dispatch\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://data\.3g\.yy\.com/popup/topLiveCardPopup\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://yyapp-act-entrance\.yy\.com/entrance/list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://yyapp-idx\.yy\.com/mobyy/nav/index/idx\? '.data[].modules |= map(select(.name != "新版本滚动条" and .name != "通栏轮播" and .name != "新静默位"))'
http-response-jq (?i)^https://tab\.yy\.com/tabs\? 'reduce [["data","tabsForSelect"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://tab\.yy\.com/tabs\? '.data.tabs |= map(select(.alias == "follow" or .alias == "im" or .alias == "me"))'
http-response-jq (?i)^https://personal-center\.yy\.com/personalCenter/list\? '.data.modules |= map(select(.moduleName != "Banner轮播")) | .data.modules |= map(if has("entrances") then .entrances |= map(select(.bizCode|IN("jishijiedaikuan","duxiaoman2","chongzhi","freeData")|not)) else . end)'
