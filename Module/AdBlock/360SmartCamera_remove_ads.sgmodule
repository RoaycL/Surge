#!name=360摄像机去广告
#!desc=移除开屏广告、首页推广、底栏商城入口及我的页面推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/360SmartCamera.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/360SmartCamera_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, ad.jia.360.cn, REJECT
DOMAIN, ad.iot.360.cn, REJECT

[MITM]
hostname = %APPEND% jia.360.cn

[Body Rewrite]
http-response-jq (?i)^https://jia\.360\.cn/conf/v1\.json 'reduce [["tab_conf"],["ad_conf"],["activity"]][] as $p (.; delpaths([$p]))'
