#!name=成分喵去广告
#!desc=移除首页推广活动、广告组件请求、移除被查商品购买链接、搜索发现。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ChengFenMiao.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/ChengFenMiao_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% app.chengfenmiao.com

[Map Local]
(?i)^https://app\.chengfenmiao\.com/Listing/LiveHots\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://app\.chengfenmiao\.com/helper/VersionCheck\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://app\.chengfenmiao\.com/item/closet\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://app\.chengfenmiao\.com/Helper/HotWords\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://app\.chengfenmiao\.com/helper/setting\? 'reduce [["detail_buy_sites"],["bottom_sites"]][] as $p (.; delpaths([$p]))'
