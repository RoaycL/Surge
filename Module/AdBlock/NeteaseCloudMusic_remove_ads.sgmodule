#!name=网易云音乐去广告
#!desc=过滤网易云音乐广告，并允许自定义界面。
#!author=RuCu6[https://github.com/RuCu6], Keywos[https://github.com/Keywos]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/NeteaseCloudMusic.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/NeteaseCloudMusic_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
#!arguments=MY:false,DT:false,FX:false,PRGG:false,PRRK:false,PRDRD:false,PRSCVPT:false,PRST:false,PRRR:false,HMPR:false,PRMST:false,PRCN:false
#!arguments-desc=MY=False；true,tag=[隐藏底栏]漫游标签,desc= | DT=False；true,tag=[隐藏底部]笔记标签,desc= | FX=False；true,tag=[隐藏底部]发现标签,desc= | PRGG=False；true,tag=[隐藏首页]问候语,desc= | PRRK=False；true,tag=[隐藏首页]排行榜,desc= | PRDRD=False；true,tag=[隐藏首页]每日推荐,desc= | PRSCVPT=False；true,tag=[隐藏首页]推荐歌单,desc= | PRST=False；true,tag=[隐藏首页]最近常听,desc= | PRRR=False；true,tag=[隐藏首页]雷达歌单,desc= | HMPR=False；true,tag=[隐藏首页]音乐合伙人,desc= | PRMST=False；true,tag=[隐藏首页]推荐专属歌单,desc= | PRCN=False；true,tag=[隐藏首页]你的专属歌单,desc=

[Rule]
DOMAIN, iadmat.nosdn.127.net, REJECT
DOMAIN, iadmatapk.nosdn.127.net, REJECT
DOMAIN, iadmusicmat.music.126.net, REJECT
DOMAIN, iadmusicmatvideo.music.126.net, REJECT
DOMAIN, ipv4.music.163.com, REJECT
DOMAIN, ipv6.music.163.com, REJECT

[MITM]
hostname = %APPEND% interface*.music.163.com

[Map Local]
(?i)^https?://interface\d?\.music\.163\.com/eapi/(?:delivery/(batch-)?deliver|moment/tab/info/|side-bar/mini-program/music-service/account|yunbei/account/entrance/) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://interface\d?\.music\.163\.com/eapi/(?:community/friends/fans-group/artist/group/|mine/applet/redpoint|music/songshare/text/recommend/|resniche/position/play/new/|resniche/tspopup/show|resource/comments?/musiciansaid/|user/sub/artist) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://interface\d?\.music\.163\.com/eapi/(?:ios/version|mlivestream/entrance/playpage/|link/position/show/strategy|link/scene/show/resource|v1/content/exposure/comment/banner/) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://interface\d?\.music\.163\.com/w?eapi/(?:activity/bonus/playpage/time/query|resource-exposure/|search/(?:chart/|rcmd/keyword/|specialkeyword/)) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://interface\d\.music\.163\.com/eapi/my/podcast/tab/recommend data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-NeteaseCloudMusic_remove_ads-rewrite-response = type=http-response, pattern="(?:(?i)^https?://interface\d?\.music\.163\.com/e?api/(ocpc/)?ad/)|(?:(?i)^https?://interface\d?\.music\.163.com/w?e?api/search/default)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/NeteaseCloudMusic_remove_ads-response.js, timeout=10
fk-NeteaseCloudMusic_remove_ads-0 = type=http-response, pattern="(?i)^https?://interface\d?\.music\.163\.com/eapi/(?:batch|v2/resource/comment/floor/get)", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, timeout=20
fk-NeteaseCloudMusic_remove_ads-1 = type=http-response, pattern="(?i)^https?://interface\d?\.music\.163\.com/eapi/(?:homepage/block/page|link/page/rcmd/(?:block/resource/multi/refresh|resource/show))", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, timeout=20, argument="PRGG={{{PRGG}}}&PRRK={{{PRRK}}}&PRDRD={{{PRDRD}}}&PRSCVPT={{{PRSCVPT}}}&PRST={{{PRST}}}&PRRR={{{PRRR}}}&HMPR={{{HMPR}}}&PRMST={{{PRMST}}}&PRCN={{{PRCN}}}"
fk-NeteaseCloudMusic_remove_ads-2 = type=http-response, pattern="(?i)^https?://interface\d?\.music\.163\.com/eapi/link/home/framework/tab", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, timeout=20, argument="MY={{{MY}}}&DT={{{DT}}}&FX={{{FX}}}"
fk-NeteaseCloudMusic_remove_ads-3 = type=http-response, pattern="(?i)^https?://interface\d?\.music\.163\.com/eapi/link/page/discovery/resource/show", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, timeout=20
fk-NeteaseCloudMusic_remove_ads-4 = type=http-response, pattern="(?i)^https?://interface\d?\.music\.163\.com/eapi/link/position/show/resource", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, timeout=20
fk-NeteaseCloudMusic_remove_ads-5 = type=http-response, pattern="(?i)^https?://interface\d?\.music\.163\.com/eapi/user/follow/users/mixed/get", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/NeteaseCloudMusic/NeteaseCloudMusic_remove_ads.js, timeout=20
