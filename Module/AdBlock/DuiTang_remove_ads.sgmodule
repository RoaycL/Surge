#!name=堆糖去广告
#!desc=移除开屏广告、信息流广告、热搜排行榜广告、我的页面横幅广告，移除关注推荐，精简底部导航栏。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DuiTang.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/DuiTang_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% www.duitang.com, api-2.duitang.com, meta.duitang.com

[Map Local]
(?i)^https://xapi\.duitang\.com/napi/ads/\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-2\.duitang\.com/napi/vienna/daren/daren/recommend/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://www\.duitang\.com/napi/hot/search/list/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://meta\.duitang\.com/napi/infra/settings/ 'reduce [["data","AD_LINKS"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://(www|api-2)\.duitang\.com/napi/home/bottom_tab/detail/\? '.data.tabs |= map(select(.group == "home" or .group == "category" or .group == "me"))'
http-response-jq (?i)^https://api-2\.duitang\.com/napi/settings/ 'reduce [["data","SPLASH_SWING_OPEN"],["data","STICKER_SEARCH_HOT_KEYWORDS"],["data","REWARD_AD_PAG_EDITOR"],["data","REWARD_AD_PHOTO_EDITOR"],["data","REWARD_AD_CUTOUT_NUM"],["data","MAIN_EVENTS"],["data","QA_TOOLTIP_BOTTOM"],["data","OC_FOLLOW_OFFICIAL"],["data","AD_MENU_SELECTIONS"],["data","FEATURE_TEMPLATES"],["data","FEEDBACK_URL"],["data","AVATAR_MALL_UPDATE"],["data","WATERMARK_MALL_UPDATE"],["data","OC_MALL_UPDATE"],["data","3D_AVATAR_UPDATE"],["data","BENEFIT_LIST"],["data","SHARE_BANNER"]][] as $p (.; delpaths([$p]))'
