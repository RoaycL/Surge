#!name=快递100去广告
#!desc=移除横幅广告、弹窗广告，精简首页。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KuaiDi100.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/KuaiDi100_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% p.kuaidi100.com

[Body Rewrite]
http-response-jq (?i)^https?://p\.kuaidi100\.com/mobile/mobileapi\.do$ 'reduce [["adsplash"],["adIsConsumable"],["adProductId"],["nologin_tips"],["index_banner"],["me_banner"],["index_banner_shadow"],["adshongbao"],["adsapp_homepage_ticket_pop"],["adsoptimizationsend"],["adsapp_activity_ad_array"],["adbanner"],["adposition"],["adShowAgainTime"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https?://p\.kuaidi100\.com/apicenter/xcx\.dox 'reduce [["data","secondMenuList"]][] as $p (.; delpaths([$p]))'

[Map Local]
(?i)^https?://p\.kuaidi100\.com/advertisement/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://p\.kuaidi100\.com/e-commerce/act/actInfo\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://p\.kuaidi100\.com/apicenter/card\.dox data-type=text data="{}" status-code=200 header="Content-Type:application/json"
