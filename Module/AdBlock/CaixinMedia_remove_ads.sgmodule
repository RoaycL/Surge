[MITM]
hostname = %APPEND% e*.caixin.com, g*.caixin.com, m*.caixin.com

[Map Local]
(?i)^https://entities\.caixin\.com/api/(dataplus/promotionHints|public/push/appIndex|public/recommendNews) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.caixin\.com/api/app-api/cxAdInfo/selectIndexAdInfo data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://mappsv5\.caixin\.com/channelv5/article_ad_ios_info\.json data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gg\.caixin\.com/s\?z=caixin&slot=\d+ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://msgapi\.caixin\.com/msg_api/annmsg/annlist data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-CaixinMedia_remove_ads-0 = type=http-response, pattern="(?i)^https://entities\.caixin\.com/api/dataplus/columns", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, timeout=15
fk-CaixinMedia_remove_ads-1 = type=http-response, pattern="(?i)^https://gateway\.caixin\.com/api/app-api/(caixinapp/appinfo|search/getkeyword)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, timeout=15
fk-CaixinMedia_remove_ads-2 = type=http-response, pattern="(?i)^https://gateway\.caixin\.com/api/app-content/fm/index/list\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, timeout=15
fk-CaixinMedia_remove_ads-3 = type=http-response, pattern="(?i)^https://gg\.caixin\.com/s\?z=caixin&op=\d", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, timeout=15
fk-CaixinMedia_remove_ads-4 = type=http-response, pattern="(?i)^https://mappsv5\.caixin\.com/articlev5/\d+/\d+\.json$", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, timeout=15
fk-CaixinMedia_remove_ads-5 = type=http-response, pattern="(?i)^https://mapps?v5\.caixin\.com/(channelv5/list|/?index_page_v5/)\w+", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/CaixinMedia/CaixinMedia_remove_ads.js, timeout=15
