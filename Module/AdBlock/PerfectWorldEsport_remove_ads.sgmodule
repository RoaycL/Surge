[MITM]
hostname = %APPEND% api.wmpvp.com, appactivity.wmpvp.com

[Body Rewrite]
http-response-jq (?i)^https://api\.wmpvp\.com/api/v1/config/promote$ 'reduce [["data","ad"]][] as $p (.; delpaths([$p]))'

[Map Local]
(?i)^https://appactivity\.wmpvp\.com/hotsearch/all\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
