# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/JD_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
URL-REGEX, "^http:\/\/\w{32}\.jddebug\.com\/diagnose\?", REJECT

[MITM]
hostname = %APPEND% api.m.jd.com

[Map Local]
(?i)^https://api\.m\.jd\.com/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06]) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://api\.m\.jd\.com/client\.action\?functionId=basicConfig '(if try (getpath(["data","JDMessage","socketmonitor"]) | has("isSocketEstablishedAhead")) catch false then setpath(["data","JDMessage","socketmonitor","isSocketEstablishedAhead"];0) else . end) | (if try (getpath(["data","JDMessage","socketmonitor"]) | has("isSocketReport")) catch false then setpath(["data","JDMessage","socketmonitor","isSocketReport"];0) else . end) | (if try (getpath(["data","JDHttpToolKit","httpdns"]) | has("httpdns")) catch false then setpath(["data","JDHttpToolKit","httpdns","httpdns"];0) else . end)'

[Script]
fk-JD_remove_ads-0 = type=http-response, pattern="(?i)^https://api\.m\.jd\.com/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/JD/JD_remove_ads.js, timeout=15
