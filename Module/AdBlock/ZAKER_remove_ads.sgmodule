#!name=ZAKER去广告
#!desc=移除开屏广告、置顶轮播图广告和文末广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ZAKER.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/ZAKER_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% iphone.myzaker.com, ggs.myzaker.com

[Map Local]
(?i)^https://iphone\.myzaker\.com/zaker/cover\.php\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://iphone\.myzaker\.com/zaker/block_top_ad\.php\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://iphone\.myzaker\.com/zaker/article_mongo_sec\.php\? 'reduce [["data","ad_url"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://ggs\.myzaker\.com/zk_article_ad\.php\? 'reduce [["data","article_bottom"],["data","recommend_ad"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://iphone\.myzaker\.com/zaker/follow_promote\.php\? '.data.list |= map(select(.type != "web"))'
http-response-jq (?i)^https://iphone\.myzaker\.com/zaker/car_tab/index\.php\? '.data.gallery |= map(select(.type != "web"))'
