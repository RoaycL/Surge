[Rule]
IP-CIDR, 203.107.1.1/24, REJECT, no-resolve

[MITM]
hostname = %APPEND% api.alipan.com, member.alipan.com, bizapi.alipan.com

[Map Local]
(?i)^https://member\.alipan\.com/v2/activity/sign_in_luckyBottle data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.alipan\.com/adrive/v1/file/getTopFolders data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-AliYunDrive_remove_ads-0 = type=http-response, pattern="(?i)^https://(biz)?api\.alipan\.com/apps/v\d/users?/home/(news|widgets)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/AliYunDrive/AliYunDrive_remove_ads.js, timeout=15
fk-AliYunDrive_remove_ads-1 = type=http-response, pattern="(?i)^https://member\.alipan\.com/v1/users/onboard_list", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/AliYunDrive/AliYunDrive_remove_ads.js, timeout=15
