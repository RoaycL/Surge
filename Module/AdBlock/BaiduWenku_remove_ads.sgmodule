#!name=百度文库去广告
#!desc=移除开屏广告、横幅广告、弹窗广告、信息流推广、搜索发现、热门搜索、资料库搜索推荐，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BaiduWenku.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/BaiduWenku_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% appwk.baidu.com, tanbi.baidu.com

[Map Local]
(?i)^https://appwk\.baidu\.com/xpage/interface/wknaad\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appwk\.baidu\.com/appapi/search/hot\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appwk\.baidu\.com/naapi/search/wkhotwords\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appwk\.baidu\.com/appapi/task/viptasklist\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appwk\.baidu\.com/activity/interface/wkapppopup\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appwk\.baidu\.com/appapi/abg/index\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appwk\.baidu\.com/naapi/recommend/recommenddoc\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appwk\.baidu\.com/naapi/recommend/vipdoccard\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://appwk\.baidu\.com/appapi/index/home\? 'reduce [["data","bannerInfo"],["data","bannerList"],["data","bannerListV2"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://(appwk|tanbi)\.baidu\.com/gsula/sula/syncmrecall$ 'reduce [["data","items"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://appwk\.baidu\.com/appapi/index/tab\? 'reduce [["data"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://appwk\.baidu\.com/appapi/forum/feed\?reqMode=wenkuapp_main_feed 'reduce [["data"]][] as $p (.; delpaths([$p]))'
