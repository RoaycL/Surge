[MITM]
hostname = %APPEND% m.riskbird.com

[Map Local]
(?i)^https://m\.riskbird\.com/prod-qbb-api/user/getBannerList data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://m\.riskbird\.com/prod-qbb-api/searchHotEnt data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-RiskBird_remove_ads-0 = type=http-response, pattern="(?i)^https://m\.riskbird\.com/prod-qbb-api/query/person/personRecommend", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/RiskBird/RiskBird_remove_ads.js, timeout=15
