#!name=华尔街见闻去广告
#!desc=移除开屏广告、文末广告、信息流广告，精简底栏。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/FinanceNews.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/FinanceNews_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% api-one-wscn.awtmt.com

[Map Local]
(?i)^https://api-one-wscn\.awtmt\.com/apiv1/advertising/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-one-wscn\.awtmt\.com/apiv1/kvconfig/items/search_keywords_wscnvip$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-one-wscn\.awtmt\.com/apiv1/search/hotsearch\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-one-wscn\.awtmt\.com/apiv1/content/articles/hot\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://wallstreetcn\.com/app-faas/coupon/user/search/popup$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-one-wscn\.awtmt\.com/apiv1/content/lives/relateddata/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-one-wscn\.awtmt\.com/apiv1/content/articles/relateddata/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-one-wscn\.awtmt\.com/apiv1/content/carousel/information-flow\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://api-one-wscn\.awtmt\.com/apiv1/kvconfig/items/tabbarconfig1$ '.data.items |= [.[] | select(.key == "news" or .key == "live")]'
http-response-jq (?i)^https://api-one-wscn\.awtmt\.com/apiv1/content/articles/ 'reduce [["data","recommend_vip_img_uri"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://api-one-wscn\.awtmt\.com//apiv1/kvconfig/items/membersrights$ 'reduce [["data","vip_article"]][] as $p (.; delpaths([$p]))'
