[MITM]
hostname = %APPEND% appapi.51jobapp.com, cupid.51jobapp.com

[Map Local]
(?i)^https://appapi\.51jobapp\.com/api/market/get_launch\.php\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cupid\.51jobapp\.com/open/operation/get/latest/banner-list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cupid\.51jobapp\.com/open/51job-activities/secJob/queryHomeSecondConfigV2\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cupid\.51jobapp\.com/open/noauth/jobs/detail/sesame-competitive/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cupid\.51jobapp\.com/open/noauth/jobs/job-detail/user-rights\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cupid\.51jobapp\.com/open/resume/strategy/resume-build\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cupid\.51jobapp\.com/launch-hub/open/noauth/popUp/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cupid\.51jobapp\.com/launch-hub/open/noauth/popUp/getHomePagePopUp\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://cupid\.51jobapp\.com/open/noauth/recommend/job-tab-dynamic\? 'reduce [["resultbody","adsTabFeeds"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://cupid\.51jobapp\.com/open/user-task/user/task/ 'reduce [["resultbody","availableTaskList"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://cupid\.51jobapp\.com/open/tab/good-job/modules\? 'reduce [["resultbody","bannerList"]][] as $p (.; delpaths([$p]))'
