[MITM]
hostname = %APPEND% www.kdocs.cn, f-api.kdocs.cn

[Map Local]
(?i)^https://www\.kdocs\.cn/kdg/api/v1/cards/type/3\?iosVer=\d+\.\d+\.\d+&isGetList=1 data-type=text data="{}" status-code=200 header="Content-Type:application/json"
