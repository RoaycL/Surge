#!name=脉脉去广告
#!desc=移除开屏广告、信息流广告、横幅推广、相关帖子推荐。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MaiMai.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/MaiMai_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% open.taou.com, h3.open.taou.com

[Map Local]
(?i)^https://(h3\.)?open\.taou\.com/maimai/adshow\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(h3\.)?open\.taou\.com/maimai/pay/v5/check_gift\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(h3\.)?open\.taou\.com/maimai/go_gossip_darwin/external/v2/query_flow_cards\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://(h3\.)?open\.taou\.com/maimai/feed/v6/detail_recommend_feeds\? 'reduce [["feeds"]][] as $p (.; delpaths([$p]))'

[Script]
fk-MaiMai_remove_ads-0 = type=http-response, pattern="(?i)^https://(h3\.)?open\.taou\.com/maimai/(feed|gossip)/v\d/(focus_feed|gossip_detail_comment|feed_detail_comment?)\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/MaiMai/MaiMai_remove_ads.js, timeout=15
