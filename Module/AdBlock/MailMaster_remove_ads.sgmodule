#!name=网易邮箱大师去广告
#!desc=移除网易邮箱大师开屏广告、签到任务提醒，精简侧拉抽屉和我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MailMaster.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/MailMaster_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% appconf.mail.163.com, dashi.163.com

[Map Local]
(?i)^https://appconf\.mail\.163\.com/mailmaster/api/http/urlConfig\.do$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://dashi\.163\.com/task-center-api/fapi/task/list$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appconf\.mail\.163\.com/mailoperating/mailmaster/api/operator/get$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://appconf\.mail\.163\.com/mailmaster/api/page/v2/conf\.do$ 'reduce [["data","functionOperatorInfoList"],["data","memberOperator"],["data","activityTabInfoList"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://appconf\.mail\.163\.com/mailmaster/api/config/function\.do$ '.data.config[] |= if .result.tools then .result.tools |= map(select(.name == "邮件追踪" or .name == "替身邮箱")) else . end | del(.data.config[] | select(.functionName == "Function-AD"))'
