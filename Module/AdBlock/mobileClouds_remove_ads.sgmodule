#!name=中国移动云盘去广告
#!desc=移除中国移动云盘开屏广告及应用内广告，首页的多余卡片可滑到最底部自定义隐藏掉，插件对此不做处理。
#!author=RuCu6[https://github.com/RuCu6]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/mobileClouds.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/mobileClouds_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% jzts.cmpassport.com, ad.mcloud.139.com

[Script]
fk-mobileClouds_remove_ads-0 = type=http-response, pattern="(?i)^https://jzts\.cmpassport\.com/personalized/getPushContent", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/mobileClouds/mobileClouds_remove_ads.js, timeout=15
fk-mobileClouds_remove_ads-1 = type=http-response, pattern="(?i)^https://ad\.mcloud\.139\.com/advertapi/adv-filter/", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/mobileClouds/mobileClouds_remove_ads.js, timeout=15
