#!name=猫耳FM去广告
#!desc=移除开屏广告、青少年模式弹窗、首页顶部入口，替换底栏的直播入口为发现入口。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/CatEarFM.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/CatEarFM_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% app.missevan.com, data.missevan.com, fm.missevan.com

[Body Rewrite]
http-response-jq (?i)^https://app\.missevan\.com/site/launch\? 'reduce [["info","splash"],["info","splash_ready"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://app\.missevan\.com/site/config$ 'reduce [["info","tab_bar_live"],["0"],["info","enable_tab_bar_live_notice"],["false"],["info","teenager_popup_mode"],["0"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://app\.missevan\.com/site/config$ 'reduce [["info","httpdns"],["info","homepage_top_task_button"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://app\.missevan\.com/site/config$ '.info.cronet |= (fromjson | .quic=false | tojson)'
http-response-jq (?i)^https://app\.missevan\.com/site/tabs\? '.info.tabs |= map(select(.title as $t | ["直播", "发现", "广播剧", "听书", "分类"] | index($t) != null))'
http-response-jq (?i)^https://app\.missevan\.com/site/icons\? '.info.icons |= map(select(.title as $t | $t == "直播" or $t == "必听剧" or $t == "免费榜" or $t == "夜猫子" or $t == "启动音"))'
http-response-jq (?i)^https://app\.missevan\.com/discovery/list$ '.info |= map(map(select(.title != "免流服务")))'
http-response-jq (?i)^https://app\.missevan\.com/site/get-top$ 'reduce [["info","search_words"]][] as $p (.; delpaths([$p]))'

[Map Local]
(?i)^https://data\.missevan\.com/site/ad-track$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://app\.missevan\.com/x/recommend/get-popup$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://fm\.missevan\.com/api/v2/meta/banner$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://fm\.missevan\.com/api/v2/recommended/top\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://fm\.missevan\.com/api/v2/chatroom/sound/recommend\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
