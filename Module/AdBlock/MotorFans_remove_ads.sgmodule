[MITM]
hostname = %APPEND% api.58moto.com

[Map Local]
(?i)^https://api\.58moto\.com/advert/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.58moto\.com/mall/goods/self/list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.58moto\.com/mall/goods/self/homeList\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.58moto\.com/forum/public/businessEssayController\.do$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://api\.58moto\.com/forum/public/businessEssayController\.do\?action=22004 'reduce [["data","link"]][] as $p (.; delpaths([$p]))'

[Script]
fk-MotorFans_remove_ads-rewrite-response = type=http-response, pattern="(?:(?i)^https://api\.58moto\.com/forum/public/businessEssayController\.do\?action=22025)|(?:(?i)^https://api\.58moto\.com/forum/public/businessEssayController\.do\?action=22038)|(?:(?i)^https://api\.58moto\.com/forum/public/labelController\.do\?action=20112)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/MotorFans_remove_ads-response.js, timeout=10
fk-MotorFans_remove_ads-0 = type=http-response, pattern="(?i)^https://api\.58moto\.com/expands/config/appWholeConfig\?key=app_whole_config$", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/MotorFans/MotorFans_remove_ads.js, timeout=15
