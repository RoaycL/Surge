[Rule]
DOMAIN, adash-evone.echargenet.com, REJECT

[MITM]
hostname = %APPEND% aserver-evone.echargenet.com, api-evone.echargenet.com

[Map Local]
(?i)^https://aserver-evone\.echargenet\.com/orange/datacenter/snapshot-meta\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-evone\.echargenet\.com/gw/evone\.echargeapi\.open\.ad\.getadmaterials/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-evone\.echargenet\.com/gw/evone\.appsns\.open\.efriend\.topic\.listrecommenttopic/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-evone\.echargenet\.com/gw/evone\.appsns\.open\.efriend\.post\.listapppost/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-evone\.echargenet\.com/gw/evone\.appsns\.open\.merchant\.merchant\.list/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-evone\.echargenet\.com/gw/evone\.appsns\.open\.merchant\.news\.pagelistapp/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
