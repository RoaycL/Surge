#!name=小桔充电去广告
#!desc=移除横幅广告、弹窗广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/XiaojukejiCharge.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/XiaojukejiCharge_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% energy.xiaojukeji.com, am.didistatic.com

[Map Local]
(?i)^https://energy\.xiaojukeji\.com/energy/hummer/api/resource/display($|\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://energy\.xiaojukeji\.com/lego/api/orderSprint/stair/info($|\?) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://energy\.xiaojukeji\.com/station-api/search/preWords$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://energy\.xiaojukeji\.com/am/marketing/api/member/facade/charge/personal/center\? 'reduce [["data"]][] as $p (.; delpaths([$p]))'

[Script]
fk-XiaojukejiCharge_remove_ads-rewrite-response = type=http-response, pattern="(?:(?i)^https://am\.didistatic\.com/static/am/cf-terminal/epower/epower-thanos-app/\d+\.\d+\.\d+/pages/people/index\.js$)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/XiaojukejiCharge_remove_ads-response.js, timeout=10
