#!name=中华万年历去广告
#!desc=移除开屏广告、弹窗、信息流推广，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/EtouchEcalendar.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/EtouchEcalendar_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, sdk.ad.sfys365.com, REJECT

[MITM]
hostname = %APPEND% v0-client-lz.rili.cn, client-lz.rili.cn

[Map Local]
(?i)^https://client-lz\.rili\.cn/lizhi/api/auth/voice_room_entrance/list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://client-lz\.rili\.cn/lizhi/api/fortune/question_spots/panel\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://client-lz\.rili\.cn/lizhi/api/jujia/flow\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://client-lz\.rili\.cn/lizhi/api/album/hl_card\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://client-lz\.rili\.cn/lizhi/api/fortune/overview\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://v0-client-lz\.rili\.cn/lizhi/api/zhwnl/cal_module/(datas|config)\? '.data |= map(select(.module_name as $name | ["实用工具","会员下icon","天气页面_右上角图标","天气页面_24小时","天气页面_15日","每日插屏","下拉屏保","星座Tab（黄历页）"] | index($name) != null))'
http-response-jq (?i)^http://pc\.suishenyun\.net/peacock/api/adspool\? '.data |= map((.layout |= map(select(.key_name == "实用工具" or .key_name == "会员下icon" or .key_name == "天气页面_右上角图标" or .key_name == "天气页面_24小时" or .key_name == "天气页面_15日" or .key_name == "每日插屏" or .key_name == "下拉屏保" or .key_name == "星座Tab（黄历页）"))) | select(.layout | length > 0))'
