[MITM]
hostname = %APPEND% god.gameyw.netease.com, app-conf.ds.163.com

[Map Local]
(?i)^https://god\.gameyw\.netease\.com/v\d/ad data-type=text data="" status-code=404 header="Content-Type:text/plain"

[Script]
fk-NetEaseGodlike_remove_ads-0 = type=http-response, pattern="(?i)^https://app-conf\.ds\.163\.com/v1/app/base/conf/static/start-config\?os=ios", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/NetEaseGodlike/NetEaseGodlike_remove_ads.js, timeout=10
