Weibo-response = type=http-response, pattern=(?:^https?://weibointl\.api\.weibo\.cn/portal\.php\?a=trends&)|(?:^https?://weibointl\.api\.weibo\.cn/portal\.php\?(ct=(feed&a=trends|user&a=get_searching_info)|a=(get_coopen_ads|user_center|search_topic|open_app&auth|icon_center)))|(?:^https?://api\.weibo\.cn/\d/statuses/.*timeline)|(?:^https?://sdkapp\.uve\.weibo\.com/interface/sdk/sdkad\.php)|(?:^https?://m?api\.weibo\.c(n|om)/2/search/(finder|container_timeline|container_discover)\?)|(?:^https?://m?api\.weibo\.c(n|om)/2/(page|flowpage)\?)|(?:^https?://m?api\.weibo\.c(n|om)/2/searchall\?)|(?:^https?://m?api\.weibo\.c(n|om)/2/statuses/container_timeline_topicpage\?)|(?:^https?://m?api\.weibo\.c(n|om)/2/statuses/container_timeline_topic\?)|(?:^https?://m?api\.weibo\.c(n|om)/2/statuses/extend\?)|(?:^https?://m?api\.weibo\.c(n|om)/2/statuses/container_detail\?)|(?:^https?://m?api\.weibo\.c(n|om)/2/groups/allgroups/v2)|(?:^https?://m?api\.weibo\.c(n|om)/2/comments/mix_comments\?)|(?:^https?://m?api\.weibo\.c(n|om)/2/statuses/(container_detail_comment|container_detail_mix)\?)|(?:^https?://m?api\.weibo\.c(n|om)/2/statuses/container_detail_forward\?)|(?:^https?://m?api\.weibo\.c(n|om)/2/(cardlist|searchall|page|messageflow|statuses/(unread_)?friends(/|_)timeline|groups/timeline|statuses/(container_timeline|container_timeline_hot|unread_hot_timeline|extend|video_mixtimeline|repost_timeline)|profile/(me|container_timeline)|video/(community_tab|remind_info|tiny_stream_video_list)|checkin/show|(\!/)?live/media_homelist|comments/build_comments|container/get_item))|(?:^https?://(sdk|wb)app\.uve\.weibo\.com(/interface/sdk/sdkad.php|/wbapplua/wbpullad.lua))|(?:^https?://api\.weibo\.c(n|om)/2/!/client/light_skin)|(?:^https?://new\.vip\.weibo\.c(n|om)/littleskin/preview)|(?:^https?://new\.vip\.weibo\.c(n|om)/aj/appicon/list), requires-body=true, max-size=2097152, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/Weibo.surge.js, timeout=15

