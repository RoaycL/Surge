#!name=百度翻译去广告
#!desc=移除开屏广告、横幅广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BaiduTranslate.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/BaiduTranslate_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% fanyi-app.baidu.com

[Map Local]
(?i)^https://fanyi-app\.baidu\.com/transapp/v2/api/launch/config\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://fanyi-app\.baidu\.com/static/react-activity/page/courseBoutique\.html\? data-type=text data="" status-code=404 header="Content-Type:text/plain"

[Body Rewrite]
http-response-jq (?i)^https://fanyi-app\.baidu\.com/transapp/comment/my\? 'reduce [["data","taskBanner"],["data","act"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://fanyi-app\.baidu\.com/transapp/recitewd/myplan\? 'reduce [["data","activityRec"],["data","activityRecList"]][] as $p (.; delpaths([$p]))'
