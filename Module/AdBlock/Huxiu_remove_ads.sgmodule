#!name=虎嗅去广告
#!desc=移除广告配置、信息流直播预约横幅、相关文章推荐、48小时热文推荐，精简搜索页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Huxiu.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Huxiu_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, api-ad-product.huxiu.com, REJECT

[MITM]
hostname = %APPEND% api-ms-config.huxiu.com, api-web-feed.huxiu.com, api-search.huxiu.com, api-article.huxiu.com, api-web-moment.huxiu.com, api-ms-feed.huxiu.com

[Map Local]
(?i)^https://api-ms-config\.huxiu\.com/v1/adConfig$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-web-feed\.huxiu\.com/v1/index/recommendContentsNew$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-search\.huxiu\.com/api/searchIndex$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-article\.huxiu\.com/v2/article/getTextArticleRelated$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api-web-moment\.huxiu\.com/v3/moment/getDetailRecdArticle$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://api-ms-feed\.huxiu\.com/v1/media/recommend$ 'reduce [["data","live"]][] as $p (.; delpaths([$p]))'
