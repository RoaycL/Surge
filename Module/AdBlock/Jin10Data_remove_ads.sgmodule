[MITM]
hostname = %APPEND% jad-api.jin10.com, common-open-api.jin10.com, search-open-api.jin10.com, cdn.jin10.com, *.z3c.jin10.com

[Map Local]
(?i)^https://jad-api\.jin10\.com/ad\d/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://common-open-api\.jin10\.com/configuration/getById\?id=1493$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://search-open-api\.jin10\.com/search/getHotWords$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cdn\.jin10\.com/json/index/hits_rank\.json\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://[0-9a-z]+\.z3c\.jin10\.com/api/home/search/hot$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://jad-api\.jin10\.com/mult/list_unread\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
