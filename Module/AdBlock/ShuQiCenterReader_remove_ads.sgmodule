# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/ShuQiCenterReader_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, render-web.11222.cn, REJECT

[MITM]
hostname = %APPEND% ocean.shuqireader.com, huichuan.sm.cn

[Map Local]
(?i)^https://huichuan\.sm\.cn/nativead data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://ocean\.shuqireader\.com/api/route/iosReadPage/adV2 data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://ocean\.shuqireader\.com/api/route/ios/readPage$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://ocean\.shuqireader\.com/api/render/load/resource data-type=text data="" status-code=404 header="Content-Type:text/plain"

[Script]
fk-ShuQiCenterReader_remove_ads-0 = type=http-response, pattern="(?i)^https://ocean\.shuqireader\.com/sqios/render/render/page/bookstore$", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/ShuQiCenterReader/ShuQiCenterReader_remove_ads.js, timeout=15
