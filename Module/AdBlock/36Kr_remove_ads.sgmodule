#!name=36氪去广告
#!desc=移除开屏广告、首页右上角运营位、信息流广告、文末广告，移除相关文章推荐、大家都在看及皮肤配置，精简搜索页面、我的页面及底栏。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/36Kr.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/36Kr_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, adx.36kr.com, REJECT
DOMAIN, ad.jiemian.com, REJECT

[MITM]
hostname = %APPEND% gateway.36kr.com, 36kr.com

[Body Rewrite]
http-response-jq (?i)^https://gateway\.36kr\.com/api/mis/sys/config\? 'reduce [["data","contentConfig"],["data","positionConfigList"],["data","switchConfig","ios","sunrise_sign"],["data","switchConfig","ios","sunrise_sunit_task"],["data","switchConfig","ios","sunrise_sunit_mall"],["data","switchConfig","ios","sunrise_distribution_icon"],["data","secondFloorConfig"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://36kr\.com/global/sensors/config/iOS\.conf\? '(if try (getpath(["configs"]) | has("disableSDK")) catch false then setpath(["configs","disableSDK"];true) else . end)'
http-response-jq (?i)^https://gateway\.36kr\.com/api/mis/nav\? '.data.navList |= [ .[] | select(.navNick == "home" or .navNick == "newsflash" or .navNick == "me") ]'
http-response-jq (?i)^https://gateway\.36kr\.com/api/mis/nav/home/subnav/recom\? '.data.bannerList |= map(select(.itemType != 0))'
http-response-jq (?i)^https://gateway\.36kr\.com/api/mis/nav/home/subnav/flow/ 'reduce [["data","adItemList"]][] as $p (.; delpaths([$p]))'

[Map Local]
(?i)^https://gateway\.36kr\.com/api/mis/nav/me/recom\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.36kr\.com/api/mis/nav/search/hotword\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.36kr\.com/api/mis/nav/search/topicListV2\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.36kr\.com/api/adx/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.36kr\.com/api/mis/page/article/recom\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.36kr\.com/api/mis/page/newsflash/recom\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.36kr\.com/api/mis/sys/skin/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
