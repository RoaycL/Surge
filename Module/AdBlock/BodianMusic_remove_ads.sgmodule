#!name=波点音乐去广告
#!desc=精简应用配置，禁用P2P传输。移除开屏广告、横幅推广、悬浮广告、歌曲广告、商城入口、搜索推广、评论区推广、试听语音提醒。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BodianMusic.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/BodianMusic_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% bd-api.kuwo.cn

[Map Local]
(?i)^https://bd-api\.kuwo\.cn/api/(play|service|advert)/advert/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bd-api\.kuwo\.cn/api/service/banner/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bd-api\.kuwo\.cn/api/ucenter/vip/give/config\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bd-api\.kuwo\.cn/api/service/home/module\?.*&moduleId=6 data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bd-api\.kuwo\.cn/api/pay/vip/lowPriceText\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bd-api\.kuwo\.cn/api/service/global/config/vipEnter\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bd-api\.kuwo\.cn/api/popup/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bd-api\.kuwo\.cn/api/pay/vip/invitation/swell/popup\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bd-api\.kuwo\.cn/api/service/version/popup\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bd-api\.kuwo\.cn/api/pay/vip/invitation/assist/popup\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bd-api\.kuwo\.cn/api/pay/h5/common/popup\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://bd-api\.kuwo\.cn/api/service/conf/all\? 'reduce [["data","groupSign","adStartAppDialog"],["data","groupSign","adGuideTest"],["data","groupSign","playTips"],["data","groupSign","adExitChange"],["data","conf","adGuidePopCount"],["data","conf","adDownListOpen"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://bd-api\.kuwo\.cn/api/service/conf/all\? '(if try (getpath(["data","conf","flowControlConfig"]) | has("uploadEnable")) catch false then setpath(["data","conf","flowControlConfig","uploadEnable"];false) else . end) | (if try (getpath(["data","conf","flowControlConfig"]) | has("p2pEnable")) catch false then setpath(["data","conf","flowControlConfig","p2pEnable"];false) else . end)'
http-response-jq (?i)^https://ab-bodian\.kuwo\.cn/abtest/ui/info\? 'reduce [["data","mapTestInfo","CommentADPosition"],["data","mapTestInfo","DiscoverADPosition"],["data","mapTestInfo","DownloadAd"],["data","mapTestInfo","FreeModVoiceReminder"],["data","mapTestInfo","GamesTrans"],["data","mapTestInfo","bodianmvdialog"],["data","mapTestInfo","MvTryShowAds"],["data","mapTestInfo","insert"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://bd-api\.kuwo\.cn/api/service/global/config/scene\? 'reduce [["data","iosP2PCacheEnable"],["data","warmStartDialog"],["data","adsNotFinishVipPop4DayInterval"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://bd-api\.kuwo\.cn/api/service/global/config/scene\? '(if try (getpath(["data"]) | has("showShopEntry")) catch false then setpath(["data","showShopEntry"];false) else . end) | (if try (getpath(["data"]) | has("iosP2pEnableSendDataLimit")) catch false then setpath(["data","iosP2pEnableSendDataLimit"];1) else . end)'
http-response-jq (?i)^https://bd-api\.kuwo\.cn/api/search/topic/word/list\? 'reduce [["data","hotTopic"],["data","searchFind"],["data","globalJumpInfo"],["data","hotWord"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://bd-api\.kuwo\.cn/api/service/home/index\? '.data.moduleList |= map(select(.type | tostring | (. != "8" and . != "1")))'
http-response-jq (?i)^https://bd-api\.kuwo\.cn/api/service/music/recommendList\? '.data.musicList[] |= del(.showAd)'
http-response-jq (?i)^https://bd-api\.kuwo\.cn/api/comments/v3/topInfo\? 'reduce [["data","putao"],["data","bannerVos"]][] as $p (.; delpaths([$p]))'
