# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/12306_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, ad.12306.cn, DIRECT

[MITM]
hostname = %APPEND% ad.12306.cn, mobile.12306.cn

[Body Rewrite]
http-response-jq (?i)^https://ad\.12306\.cn/ad/ser/getAdList$ 'reduce [["materialsList"],["advertParam"]][] as $p (.; delpaths([$p]))'

[Script]
fk-12306_remove_ads-0 = type=http-request, pattern="(?i)^https://mobile\.12306\.cn/otsmobile/app/mgs/mgw\.htm$", script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/12306/12306_remove_ads.js, timeout=15
