[Map Local]
^http://rich\.kuwo\.cn/AdService/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^http://wapi\.kuwo\.cn/openapi/v\d/user/freeMode/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^http://wapi\.kuwo\.cn/openapi/v\d/app/pasterAdvert/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^http://wapi\.kuwo\.cn/openapi/v\d/app/startup/config data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^http://rich\.kuwo\.cn/EcomResourceServer/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^http://searchrecterm\.kuwo\.cn/recterm\.s data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^http://wapi\.kuwo\.cn/openapi/v\d/app/newMenuList/menuListInfo data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^http://vip\d\.kuwo\.cn/vip/v\d/sysinfo\?op=getRePayAndDoPayBox data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^http://wapi\.kuwo\.cn/openapi/v\d/album/adBar/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://vip\d\.kuwo\.cn/commercia/vipconf/projectPage/getPageContent data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://tingshu\.kuwo\.cn/v2/api/pay/user/info data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://appi\.kuwo\.cn/kuwopay/personal/cells data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Rule]
IP-CIDR, 111.206.98.63/32, REJECT, no-resolve

[MITM]
hostname = %APPEND% appi.kuwo.cn, mc.tencentmusic.com, vip*.kuwo.cn, tingshu.kuwo.cn

[Body Rewrite]
http-response-jq (?i)^http://wapi\.kuwo\.cn/openapi/v\d/tingshu/index/radio 'walk(if type == "object" and .type == "stripAdvert" then del(.child) else . end)'
