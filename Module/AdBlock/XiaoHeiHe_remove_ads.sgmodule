#!name=小黑盒去广告
#!desc=移除开屏广告和热点板块信息流广告
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/XiaoHeiHe.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/XiaoHeiHe_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% api.xiaoheihe.cn

[Map Local]
(?i)^https://api\.xiaoheihe\.cn/account/get_ads_info_v2 data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://api\.xiaoheihe\.cn/bbs/app/feeds/news '.result.links |= map(if .content_type == 27 then del(.title, .ad_pm, .img_gif, .idea_id, .ad_report, .label, .source, .intranet_only, .ad_cm, .content_type, .PROTOCOL, .img, .ad_ratio) else . end)'
