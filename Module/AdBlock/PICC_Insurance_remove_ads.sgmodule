[MITM]
hostname = %APPEND% zgrb.epicc.com.cn

[Map Local]
(?i)^https://zgrb\.epicc\.com\.cn/G-HAPP/h/headlines/queryHeadlines data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://zgrb\.epicc\.com\.cn/G-HAPP/a/update/startupPage/v1 data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://zgrb\.epicc\.com\.cn/G-HAPP/a/config/guessYouLike/v3 data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-PICC_Insurance_remove_ads-0 = type=http-response, pattern="(?i)^https://zgrb\.epicc\.com\.cn/G-HAPP/a/config/homeInit/v3", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/PICC_Insurance/PICC_Insurance_remove_ads.js, timeout=15
fk-PICC_Insurance_remove_ads-1 = type=http-response, pattern="(?i)^https://zgrb\.epicc\.com\.cn/G-HAPP/mpageconfig/myPageConfigList/v3", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/PICC_Insurance/PICC_Insurance_remove_ads.js, timeout=15
