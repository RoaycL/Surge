#!name=Spotify去广告
#!desc=移除播放广告，恢复歌手和专辑列表的正常展示。修改插件自定义配置项需要重新登陆方可生效。
#!author=001ProMax[https://github.com/001ProMax]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Spotify_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
#!arguments=tab:false,useractivity:true
#!arguments-desc=tab=False；true,tag=移除底栏创建按钮,desc=此开关控制是否移除底栏创建按钮 | useractivity=True；false,tag=启用Apple设备接力,desc=此开关控制是否使用Apple设备接力

[Rule]
AND, ((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)), REJECT

[MITM]
hostname = %APPEND% *-spclient.spotify.com, spclient.wg.spotify.com

[Map Local]
(?i)^https://(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?/pendragon/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-Spotify_remove_ads-rewrite-request = type=http-request, pattern="(?:(?i)^https://(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?/artistview/v1/artist/(.*)&platform=iphone)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/Spotify_remove_ads-request.js, timeout=10
fk-Spotify_remove_ads-0 = type=http-response, pattern="(?i)^https://(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?/(?:bootstrap|user-customization-service)", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Spotify/Spotify_remove_ads.js, timeout=5, argument="tab={{{tab}}}&useractivity={{{useractivity}}}"
