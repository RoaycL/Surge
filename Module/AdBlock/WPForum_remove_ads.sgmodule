[MITM]
hostname = %APPEND% api.wfdata.club

[Map Local]
(?i)^https://api\.wfdata\.club/v2/yesfeng/yesList\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://api\.wfdata\.club/v2/yesfeng/slideshow\? '.data |= map(select(.protocolId == 1))'
