[MITM]
hostname = %APPEND% m.baidu.com, www.baidu.com

[Script]
fk-BaiduSearchWebpage_remove_ads-0 = type=http-response, pattern="(?i)^https?://(www|m)\.baidu\.com/?($|\?from=\w{8,9})", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/BaiduSearch/BaiduSearchHomePage_remove_ads.js, timeout=15
