#!name=最右去广告
#!desc=移除开屏广告、信息流广告和广告轮播图。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ZuiYou.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/ZuiYou_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, adapi.izuiyou.com, REJECT
URL-REGEX, "^http:\/\/file-share\.izuiyou\.com\/octopus\/media\/templates\/search_home_page_(nv|nv_v2)\/search_home_page_nv", REJECT

[Map Local]
^http://mercury-gateway\.ixiaochuan\.cn/mercury/v1/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://api\.izuiyou\.com/config/get_banner data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://api\.izuiyou\.com/ad/ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://zyfile\.izuiyou\.com/zyfile/c2/a0/[a-z0-9-]+\.json data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.izuiyou.com, zyfile.izuiyou.com
