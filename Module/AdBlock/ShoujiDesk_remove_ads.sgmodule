[MITM]
hostname = %APPEND% api.tdz5.com

[Map Local]
(?i)^https://api\.tdz5\.com/search/hotword\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.tdz5\.com/ring/hot\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-ShoujiDesk_remove_ads-0 = type=http-response, pattern="(?i)^https://api\.tdz5\.com/base/init\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/ShoujiDesk/base_init.js, timeout=15
