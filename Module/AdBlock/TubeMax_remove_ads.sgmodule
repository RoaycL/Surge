#!name=TubeMax去广告
#!desc=过滤TubeMax广告
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TubeMax.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/TubeMax_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
# NOTE: 主配置需添加：RULE-SET,https://raw.githubusercontent.com/RoaycL/Surge/main/Ruleset/AdBlock/TubeMax_remove_ads.list,节点选择（替换为你的代理策略）。

[Rule]
DOMAIN-SUFFIX, adjust.com, REJECT
DOMAIN-SUFFIX, applvn.com, REJECT
DOMAIN-SUFFIX, app-measurement.com, REJECT
DOMAIN-SUFFIX, pangle.io, REJECT
DOMAIN-SUFFIX, applovin.com, REJECT
DOMAIN-SUFFIX, appier.net, REJECT
DOMAIN-SUFFIX, adsmoloco.com, REJECT
DOMAIN-SUFFIX, adcanvas.com, REJECT

[MITM]
hostname = %APPEND% *.i18n-pglstatp.com

[Map Local]
(?i)^https://.*\.i18n-pglstatp\.com/obj/ad-pattern-sg data-type=text data="" status-code=404 header="Content-Type:text/plain"
