#!name=IT之家去广告
#!desc=过滤IT之家信息流广告和文末广告，自定义移除置顶和轮播图，自定义移除项需在插件配置。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/IThome.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/IThome_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
#!arguments=removePinnedArticles:false,removeAllBanners:false
#!arguments-desc=removePinnedArticles=False；true,tag=移除置顶文章,desc=启用后将移除置顶文章 | removeAllBanners=False；true,tag=移除全部横幅,desc=启用后将移除全部横幅

[MITM]
hostname = %APPEND% napi.ithome.com, api.zuihuimai.com, dat.ruanmei.com

[Map Local]
(?i)^https?://dat\.ruanmei\.com/ithome/money/acd\.json$ data-type=text data="" status-code=404 header="Content-Type:text/plain"

[Script]
fk-IThome_remove_ads-0 = type=http-response, pattern="(?i)^https://napi\.ithome\.com/api/(news/indexv2/iphone/\d+|topmenu/getfeeds\?)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/IThome/IThome_remove_ads.js, timeout=15, argument="removeAllBanners={{{removeAllBanners}}}&removePinnedArticles={{{removePinnedArticles}}}"
