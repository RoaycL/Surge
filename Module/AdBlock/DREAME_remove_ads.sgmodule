#!name=DREAME去广告
#!desc=移除开屏广告、首页大图推广、横幅推广，精简底栏，阻止桌面图标替换。仅支持2.5.1版。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DREAME.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/DREAME_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% cn-mall.dreame.tech, cn-wxmall.dreame.tech, cn.iot.dreame.tech

[Map Local]
(?i)^https://cn\.iot\.dreame\.tech:\d+/dreame-product/public/advertisement/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cn-mall\.dreame\.tech/dreame-mall/api/v1/tag/list$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cn-wxmall\.dreame\.tech/main/goods/get-topgoods$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://cn\.iot\.dreame\.tech:13267/dreame-system/dreame-app/setting/query$ 'reduce [["data","appIconConfig"]][] as $p (.; delpaths([$p]))'

[Script]
fk-DREAME_remove_ads-rewrite-response = type=http-response, pattern="(?:(?i)^https://cn\.iot\.dreame\.tech:\d+/dreame-product/public/common-plugin$)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/DREAME_remove_ads-response.js, timeout=10
