[MITM]
hostname = %APPEND% iosapi.peiyinxiu.com

[Body Rewrite]
http-response-jq (?i)^https://iosapi\.peiyinxiu\.com/Api/live/LiveList 'reduce [["data","banners"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://iosapi\.peiyinxiu\.com/api/live/FollowList 'reduce [["obj","data"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://iosapi\.peiyinxiu\.com/Api/Friend/GetRecommendUsers 'reduce [["obj","data"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://iosapi\.peiyinxiu\.com/api/Union/HomeData 'reduce [["obj","data"]][] as $p (.; delpaths([$p]))'

[Script]
fk-DubbingShow_remove_ads-0 = type=http-response, pattern="(?i)^https://iosapi\.peiyinxiu\.com/Api/Film/GetConfigValue", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/DubbingShow/DubbingShow_remove_ads.js, timeout=15
