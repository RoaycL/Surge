#!name=智联招聘去广告
#!desc=移除开屏广告、弹窗、职位页面推广和各类横幅推广。此插件需要IPA签名方可使用，App Store用户请勿使用此插件，务必点击下方主页链接查看详细教程。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ZhiLianZhaoPin.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/ZhiLianZhaoPin_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
URL-REGEX, "^https:\/\/(ask|cgate)\.zhaopin\.com\/operation\/ad\/", REJECT

[MITM]
hostname = %APPEND% ask.zhaopin.com, cgate.zhaopin.com

[Body Rewrite]
http-response-jq (?i)^https://ask\.zhaopin\.com/plat-zqa-server/home/\d\.\d\.\d/getHomeContents\? 'reduce [["data","templates",0,"data","banner"]][] as $p (.; delpaths([$p]))'

[Map Local]
(?i)^https://cgate\.zhaopin\.com/resumeapi/resumeCheck/positionDetailBottomTipCheck$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cgate\.zhaopin\.com/bdp/commercial/queryLinkData$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
