#!name=Sofascore去广告
#!desc=移除横幅及信息流广告
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Sofascore.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Sofascore_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% api.sofascore.com

[Map Local]
(?i)^https://api\.sofascore\.com/api/v\d/dsp/country/[A-Z]{2}$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-Sofascore_remove_ads-rewrite-response = type=http-response, pattern="(?:(?i)^https://api\.sofascore\.com/api/v\d/trending/grid/tiles/[A-Z]{2}$)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/Sofascore_remove_ads-response.js, timeout=10
