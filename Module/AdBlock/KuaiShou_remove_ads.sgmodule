#!name=快手去广告
#!desc=移除开屏广告、视频流广告、底栏皮肤、右下角悬浮推广，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KuaiShou.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/KuaiShou_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% az*-api.ksapisrv.com, az4-api-idc.ksapisrv.com, az*-api-idc.ksapisrv.com, apissl.gifshow.com, apissl.ksapisrv.com, az*-api-js.gifshow.com, az*-live.ksapisrv.com

[Body Rewrite]
http-response-jq (?i)^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/system/startup\? 'reduce [["reskinConfig"],["sidebarExSquareStyle","moreList"],["sidebarExSquareStyle","topList"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/system/startup\? '.sidebarExSquareStyle.commonlyUsedList |= map(select(.title == "设置" or .title == "历史记录" or .title == "草稿箱" or .title == "我的钱包" or .title == "小程序" or .title == "未成年人模式" or .title == "官方客服" or .title == "内容偏好" or .title == "离线模式" or .title == "稍后再看" or .title == "举报中心" or .title == "挂件"))'
http-response-jq (?i)^https://(apissl|az\d-live|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/live/feed/square/refresh\? 'reduce [["data","banners"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/feed/(selection|selectionFast)\? 'if (.feeds | type) == "array" then .feeds |= map(select(.ad | not)) else . end'
http-response-jq (?i)^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/user/profile/v2\? 'reduce [["postRecommends"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/im/wd/top/navigation/getRecommendedSession\? 'reduce [["data","operationRecommendationList"]][] as $p (.; delpaths([$p]))'

[Map Local]
(?i)^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/nearby/widget/info\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/taskCenter/task/report\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(apissl|az\d-api(-js|-idc)?)\.(gifshow|ksapisrv)\.com/rest/n/live/feed/info/simplelive/card\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
