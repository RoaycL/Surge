#!name=天气预报去广告
#!desc=移除开屏广告、弹窗广告、横幅广告、悬浮挂件，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/iReaderCityWeather.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/iReaderCityWeather_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, adsys.nineton.cn, REJECT
DOMAIN, adcdn.ccqyj.com, REJECT

[Script]
fk-iReaderCityWeather_remove_ads-rewrite-response = type=http-response, pattern="(?:(?i)^http://weatherapi\.ccqyj\.com/server/listsv\d$)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/iReaderCityWeather_remove_ads-response.js, timeout=10
