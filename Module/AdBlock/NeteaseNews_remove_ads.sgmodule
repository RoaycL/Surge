#!name=网易新闻去广告
#!desc=移除开屏广告、置顶新闻、热搜列表和搜索栏填充词。
#!author=RuCu6[https://github.com/RuCu6]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/NeteaseNews.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/NeteaseNews_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, nex.163.com, DIRECT
DOMAIN, gw.m.163.com, DIRECT

[MITM]
hostname = %APPEND% nex.163.com, interface.music.163.com, c.m.163.com, client.mail.163.com, g1.163.com, support.you.163.com, interface3?.music.163.com, gw.m.163.com

[Map Local]
(?i)^https?://interface\.music\.163\.com/eapi/ad data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https?://c\.m\.163\.com/nc/gl/ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https?://client\.mail\.163\.com/apptrack/confinfo/searchMultiAds data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https?://g1\.163\.com/madfeedback data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https?://interface\.music\.163\.com/eapi/ad/ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https?://support\.you\.163\.com/xhr/boot/getBootMedia\.json data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https?://interface3?\.music\.163\.com/eapi/(ad|abtest|sp|hot|store|search/(specialkeyword|defaultkeyword|hot)) data-type=text data="" status-code=404 header="Content-Type:text/plain"

[Script]
fk-NeteaseNews_remove_ads-0 = type=http-response, pattern="(?i)^https://nex\.163\.com/q", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/NeteaseNews/NeteaseNews_remove_ads.js, timeout=15
fk-NeteaseNews_remove_ads-1 = type=http-response, pattern="(?i)^https://gw\.m\.163\.com/nc/api/v1/feed/dynamic/headline-list\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/NeteaseNews/NeteaseNews_remove_ads.js, timeout=15
fk-NeteaseNews_remove_ads-2 = type=http-response, pattern="(?i)^https://gw\.m\.163\.com/nc/api/v1/search/hot-word", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/NeteaseNews/NeteaseNews_remove_ads.js, timeout=15
