#!name=马蜂窝去广告
#!desc=移除首页信息流广告、商城横幅推广、我的页面弹窗。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MaFengWo.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/MaFengWo_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, advert.mafengwo.cn, REJECT

[MITM]
hostname = %APPEND% mapi.mafengwo.cn

[Body Rewrite]
http-response-jq (?i)^https://mapi\.mafengwo\.cn/discovery/get_index/v7\? '.data.list |= map(select(.data.business_type != "gdcpm"))'
http-response-jq (?i)^https://mapi\.mafengwo\.cn/sales/home/get_header/v3\? '.data.list[] |= ( .data |= del(.banners) )'

[Map Local]
(?i)^https://mapi\.mafengwo\.cn/user/growth/get_growth_tip/v1\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
