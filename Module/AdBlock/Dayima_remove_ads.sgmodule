[MITM]
hostname = %APPEND% forumapi.yoloho.com, dataapi.yoloho.com, shop18476221.m.youzan.com

[Body Rewrite]
http-response-jq (?i)^https://forumapi\.yoloho\.com/index/recommend/listV\d\? '.recommendList |= map(select(.voType == 0))'
http-response-jq (?i)^https://dataapi\.yoloho\.com/tool/bubble/event/new/iconList\? '.data |= map(select(.id == 21 or .id == 23 or .id == 24 or .id == 40))'
http-response-jq (?i)^https://dataapi\.yoloho\.com/tool/card/mine/app\? '.data |= map(select(.type == "1"))'

[Map Local]
(?i)^https://forumapi\.yoloho\.com/topic/relate/recommend/flow/getList\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://shop18476221\.m\.youzan\.com/wscshop/showcase/feature\? data-type=text data="" status-code=404 header="Content-Type:text/plain"
