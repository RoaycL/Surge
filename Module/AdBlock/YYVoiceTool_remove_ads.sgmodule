[MITM]
hostname = %APPEND% yuyin-api.baizhanlive.com, web.yy.com

[Map Local]
(?i)^https://yuyin-api\.baizhanlive\.com/homepage/flashscreen/get\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://yuyin-api\.baizhanlive\.com/homepage/homepage/banner\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://web\.yy\.com/yyvoice_task_sys/bar\.html\? data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://yuyin-api\.baizhanlive\.com/search/search/hotword\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://yuyin-api\.baizhanlive\.com/postsquare/college/page/tabsV3\? '.data.tabList |= map(select(.code == "post" or .code == "teamup" or .code == "college" or .code == "aiSecretRoom"))'
