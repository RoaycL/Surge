#!name=阅友去广告
#!desc=移除开屏广告、弹窗广告和阅读页面广告，移除底栏福利按钮。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Yueyou.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Yueyou_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, ads.reader.yueyouxs.com, REJECT

[MITM]
hostname = %APPEND% goway.reader.yueyouxs.com

[Body Rewrite]
http-response-jq (?i)^https://goway\.reader\.yueyouxs\.com/assemble/app/basic/getAppInfo\? 'reduce [["data","isShowDLPopup"],["data","isShowGame"],["data","touTiaoShowDlPopup"],["data","offLineDownload","WatchVideoBtnDesc"],["data","readVipFirstCfg"],["data","readVipNormalCfg"],["data","notifyAd"],["data","hotStartSplashTime"],["data","hotStartReqSwitch"],["data","isShowBFTab"],["data","popReqDelayTime"],["data","benefitCfg"],["data","chestTask"],["data","hotStartAd"],["data","activeTagList"],["data","secondOrderCfg"],["data","secondOrderList"],["data","blockedWordsCfg"],["data","aaReportListCfg"],["data","pddAdSwitch"],["data","isShowShelfAuthPopup"],["data","firstPopUpAmount"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://goway\.reader\.yueyouxs\.com/assemble/app/basic/getAppInfo\? '(if try (getpath(["data"]) | has("isAdClosed")) catch false then setpath(["data","isAdClosed"];true) else . end)'
