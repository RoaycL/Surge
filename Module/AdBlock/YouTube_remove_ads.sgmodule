#!name=YouTube去广告
#!desc=移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底栏的Shorts按钮和上传按钮，增加画中画及字幕翻译功能。移除YouTube Music底栏的上传、选段和升级按钮，增加歌词翻译，支持二者的后台播放。此插件需要启用MitM over HTTP/2和QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。
#!author=Maasea[https://github.com/Maasea], VirgilClyne[https://github.com/VirgilClyne], Choler[https://github.com/Choler], DivineEngine[https://github.com/DivineEngine], app2smile[https://github.com/app2smile]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/YouTube_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
#!arguments=blockUpload:false,blockShorts:false,blockImmersive:false,captionLang:zh-Hans,debug:false
#!arguments-desc=blockUpload=False；true,tag=隐藏上传按钮,desc=用于隐藏YouTube底栏的上传按钮 | blockShorts=False；true,tag=隐藏Shorts按钮,desc=用于隐藏YouTube底栏的Shorts按钮 | blockImmersive=False；true,tag=隐藏选段按钮,desc=用于隐藏YouTube Music底栏的选段按钮 | captionLang=zh-Hans；"zh-Hant","ja","ko","en","off",tag=字幕翻译语言,desc=需要把YouTube字幕翻译翻译为何种语言 | debug=False；true,tag=启用调试模式,desc=此插件的调试模式

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com

[Script]
fk-YouTube_remove_ads-0 = type=http-response, pattern="(?i)^https://youtubei\.googleapis\.com/(youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config))(\?(.*))?$", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_response.js, timeout=15, argument="blockUpload={{{blockUpload}}}&blockShorts={{{blockShorts}}}&blockImmersive={{{blockImmersive}}}&captionLang={{{captionLang}}}&debug={{{debug}}}"
fk-YouTube_remove_ads-1 = type=http-request, pattern="(?i)^https?://[\w-]+\.googlevideo\.com/initplayback.+&ack.*", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js, timeout=15, argument="captionLang={{{captionLang}}}"
fk-YouTube_remove_ads-2 = type=http-request, pattern="(?i)^https://youtubei\.googleapis\.com/youtubei/v1/log_event", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js, timeout=15, argument="blockUpload={{{blockUpload}}}&blockShorts={{{blockShorts}}}&blockImmersive={{{blockImmersive}}}&captionLang={{{captionLang}}}&debug={{{debug}}}"
