[MITM]
hostname = %APPEND% api.boohee.com, bohe.sfo-tx-shanghai-01.saas.sensorsdata.cn, lego.boohee.com, status.boohee.com

[Body Rewrite]
http-response-jq (?i)^https://api\.boohee\.com/meta-interface/v2/index\? 'reduce [["data","recom_cards"],["data","recom_btns"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://api\.boohee\.com/meta-interface/v1/index/plaza\? 'reduce [["data","tabs",1,"badge"],["data","recommend_ads"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://api\.boohee\.com/open-interface/v1/string/market_page\?title=metabolism_config$ 'reduce [["top_banner"],["diagnos_config"],["partner_hospital"],["question_answer"],["product"],["brand_story"]][] as $p (.; delpaths([$p]))'

[Map Local]
(?i)^https://api\.boohee\.com/meta-interface/v1/index/page_float_bubbles\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.boohee\.com/meta-interface/v1/index/tool_buttons\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.boohee\.com/app-interface/v1/search/search\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://status\.boohee\.com/api/v1/merged_messages$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bohe\.sfo-tx-shanghai-01\.saas\.sensorsdata\.cn/api/v2/sfo/user_popup_configs\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.boohee\.com/meta-interface/v1/index/sensor-banners\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-BooHee_remove_ads-0 = type=http-response, pattern="(?i)^https://api\.boohee\.com/meta-interface/v1/index/plaza-flow\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/BooHee/BooHee_remove_ads.js, timeout=15
