#!name=淘票票去广告
#!desc=移除开屏广告、悬浮广告、轮播图广告和弹窗广告，移除搜索填充词和为你推荐。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Taopiaopiao.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Taopiaopiao_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% acs.m.taobao.com

[Map Local]
(?i)^https://acs\.m\.taobao\.com/gw/mtop\.film\.life\.popup\.get/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://acs\.m\.taobao\.com/gw/mtop\.film\.mtopindependentadvertiseapi\.queryadvertise/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://acs\.m\.taobao\.com/gw/mtop\.film\.mtopitemadvertiseapi\.queryadvertise/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://acs\.m\.taobao\.com/gw/mtop\.film\.mtopintegrationapi\.homeconfig/ 'reduce [["data","returnValue","floatingBanner"],["data","returnValue","searchShadeList"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://acs\.m\.taobao\.com/gw/mtop\.film\.mtopintegrationapi\.homeconfig/ '.data.returnValue.topTab |= map(select(.activeImage | not)) | .data.returnValue.topTab |= map(del(.backgroundColor))'
http-response-jq (?i)^https://acs\.m\.taobao\.com/gw/mtop\.film\.life\.aristotle\.get/ 'def filter_nodes: map(if .data.componentId? and (.data.componentId | type == "string") and (.data.componentId | (contains("tpp_banner") or . == "tpp_guess_like")) then empty else .nodes |= (if . then filter_nodes else . end) end); .data.nodes |= (if . then filter_nodes else . end)'
