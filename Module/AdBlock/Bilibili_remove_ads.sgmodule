#!name=哔哩哔哩去广告
#!desc=过滤哔哩哔哩广告、移除青少年模式弹窗和交互式弹幕、移除无用功能和链接跟踪参数，增加空降助手以便跳过视频中插入的广告。此插件仅建议iOS 15以上设备使用，且必须启用MitM-over-HTTP/2功能。\n\n空降助手是第三方提供的功能，依赖于Android版空降助手的服务器数据运作，可能会存在不准确或者失效的问题，此功能与哔哩哔哩官方无关。
#!author=kokoryh[https://github.com/kokoryh]
#!category=去广告
#!homepage=https://github.com/RoaycL/Surge
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Bilibili.png
#!date=2026-10-02 13:57:49
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Bilibili_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
#!arguments=displayUpList:show,purifyComment:true,optimizeRequest:true,sponsorBlock:false,logLevel:off
#!arguments-desc=displayUpList=show；"hide","auto",tag=[动态]中[最常访问]的显示方式,desc=auto：仅当列表中存在直播状态时显示；show：始终显示；hide：始终隐藏。 | purifyComment=True；false,tag=移除评论区置顶广告,desc=移除评论区置顶广告 | optimizeRequest=True；false,tag=优化评论区加载异常,desc=尝试解决评论区加载异常的问题 | sponsorBlock=False；true,tag=空降助手,desc=用于跳过视频中的广告 | logLevel=off；"error","warn","info","debug",tag=日志等级,desc=脚本的日志输出等级
# NOTE: 主配置需添加：RULE-SET,https://raw.githubusercontent.com/RoaycL/Surge/main/Ruleset/AdBlock/Bilibili_remove_ads.list,节点选择（替换为你的代理策略）。

[Rule]
DOMAIN, api.biliapi.com, REJECT
DOMAIN, app.biliapi.com, REJECT
DOMAIN, api.biliapi.net, REJECT
DOMAIN, app.biliapi.net, REJECT
AND, ((DOMAIN-SUFFIX, chat.bilibili.com), (OR, ((DOMAIN-KEYWORD, stun), (DOMAIN-KEYWORD, tracker), (DOMAIN-KEYWORD, p2p)))), REJECT

[MITM]
hostname = %APPEND% grpc.biliapi.net, app.bilibili.com, api.bilibili.com, api.live.bilibili.com, line3-h5-mobile-api.biligame.com

[Body Rewrite]
http-response-jq (?i)^https://api\.bilibili\.com/x/pd-proxy/tracker\? '.data[][]?="stun.chat.bilibili.com:3478"'
http-response-jq (?i)^https://app\.bilibili\.com/x/v2/splash/(show|event/list2)\? '.data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end)'
http-response-jq (?i)^https://app\.bilibili\.com/x/v2/feed/index\? 'if .data.items then .data.items |= map(select((.banner_item == null) and (.ad_info == null) and (.card_goto == "av") and (.card_type | IN("small_cover_v2", "large_cover_single_v9", "large_cover_v1")))) end'
http-response-jq (?i)^https://api\.bilibili\.com/pgc/view/v2/app/season\? 'del(.data.payment)'
http-response-jq (?i)^https://api\.bilibili\.com/pgc/page/channel\? '.data.modules |= map(select(.type != "TIP") | if .type == "BANNER" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end)'
http-response-jq (?i)^https://app\.bilibili\.com/x/v2/feed/index/story\? 'if .data.items then .data.items |= map(select((.ad_info == null) and (.card_goto | IN("vertical_ad_av", "vertical_ad_live", "vertical_ad_picture") | not)) | del(.story_cart_icon, .free_flow_toast, .image_infos, .course_info, .game_info)) end'
http-response-jq (?i)^https://api\.live\.bilibili\.com/xlive/open-interface/v2/tracker/conf\? '.data.domains=["wss://tracker.chat.bilibili.com"]'
http-response-jq (?i)^https://app\.bilibili\.com/x/resource/show/skin\? 'reduce [["data","common_equip"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://app\.bilibili\.com/x/v2/account/myinfo\? '.data.vip |= if . != null and .status == 0 then . + { status: 1, type: 2, due_date: 9005270400000, role: 15 } else . end'

[Script]
fk-Bilibili_remove_ads-external-jq-35 = type=http-response, pattern="(?i)^https://app\.bilibili\.com/x/resource/show/tab/v2\?", requires-body=true, max-size=1048576, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/Bilibili-tab_Bilibili_remove_ads.js, timeout=5
fk-Bilibili_remove_ads-external-jq-56 = type=http-response, pattern="(?i)^https://app\.bilibili\.com/x/v2/account/mine(/ipad)?\?", requires-body=true, max-size=1048576, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/Bilibili-mine_Bilibili_remove_ads.js, timeout=5
fk-Bilibili_remove_ads-rewrite-response = type=http-response, pattern="(?:(?i)^https://app\.bilibili\.com/x/v2/splash/list\?)|(?:(?i)^https://api\.bilibili\.com/pgc/activity/deliver/material/receive\?)|(?:(?i)^https://ap[ip]\.bilibili\.com/x/(resource/(top/activity|patch/tab(/v2)?)|v2/search/square|vip/ads/materials)\?)|(?:(?i)^https://grpc\.biliapi\.net/bilibili\.app\.interface\.v1\.Teenagers/ModeStatus$)|(?:(?i)^https://grpc\.biliapi\.net/bilibili\.app\.interface\.v1\.Search/DefaultWords$)|(?:(?i)^https://grpc\.biliapi\.net/bilibili\.app\.(view\.v1\.View/TFInfo|viewunite\.v1\.View/(PlayPause|ViewEndPage))$)|(?:(?i)^https://grpc\.biliapi\.net/bilibili\.app\.(interface\.v1\.(Teenagers/ModeStatus|Search/DefaultWords)|view\.v1\.View/TFInfo|viewunite\.v1\.View/(PlayPause|ViewEndPage))$)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/Bilibili_remove_ads-response.js, timeout=10
fk-Bilibili_remove_ads-0 = type=http-request, pattern="(?i)^https://(?:grpc\.biliapi\.net|app\.bilibili\.com)/bilibili\.community\.service\.dm\.v1\.DM/DmSegMobile$", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Bilibili/Bilibili_proto_request_kokoryh.js, timeout=10, argument="logLevel={{{logLevel}}}&__enable={{{sponsorBlock}}}"
fk-Bilibili_remove_ads-1 = type=http-request, pattern="(?i)^https://(?:grpc\.biliapi\.net|app\.bilibili\.com)/bilibili\.(?:app\.viewunite\.v1\.View/View|main\.community\.reply\.v1\.Reply/MainList)$", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Bilibili/Bilibili_proto_request_kokoryh.js, timeout=10, argument="purifyComment={{{purifyComment}}}&logLevel={{{logLevel}}}&__enable={{{optimizeRequest}}}"
fk-Bilibili_remove_ads-2 = type=http-response, pattern="(?i)^https://(grpc\.biliapi\.net|app\.bilibili\.com)/bilibili\.(app\.(show\.v1\.Popular/Index|dynamic\.v2\.Dynamic/DynAll|view(unite)?\.v1\.View/(View|ViewProgress|RelatesFeed|AIRelateAsync)|playurl\.v1\.PlayURL/PlayView|playerunite\.v1\.Player/PlayViewUnite)|polymer\.app\.search\.v1\.Search/SearchAll|community\.service\.dm\.v1\.DM/DmView|main\.community\.reply\.v1\.Reply/MainList|pgc\.gateway\.player\.v2\.PlayURL/PlayView)$", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Bilibili/Bilibili_proto_response_kokoryh.js, timeout=15, argument="displayUpList={{{displayUpList}}}&purifyComment={{{purifyComment}}}&sponsorBlock={{{sponsorBlock}}}&logLevel={{{logLevel}}}"
fk-Bilibili_remove_ads-3 = type=http-response, pattern="(?i)^https://api\.live\.bilibili\.com/xlive/(?:app-interface/v2/index/feed|app-room/v1/index/getInfoBy(?:Room|User))\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Bilibili/Bilibili_json_kokoryh.js, timeout=15

[Map Local]
(?i)^https://line3-h5-mobile-api\.biligame\.com/game/live/large_card_material\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.live\.bilibili\.com/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_info\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
