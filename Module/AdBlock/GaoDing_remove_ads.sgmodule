[MITM]
hostname = %APPEND% www.gaoding.com

[Map Local]
(?i)^https://www\.gaoding\.com/api/v\d/oc/v\d/delivery-pits/ios-splash/modules$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://www\.gaoding\.com/api/v\d/oc/delivery-pits/(template|mine|home)-page-dialog/modules$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://www\.gaoding\.com/api/v\d/cp/search-words/v2/placeholder data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://www\.gaoding\.com/api/v\d/oc/exhibitions/template/resources$ '.pits |= map(select(.module_type != "BANNER"))'
http-response-jq (?i)^https://www\.gaoding\.com/api/v\d/oc/exhibitions/app_mine/resources$ '.pits |= map(select(.module_type != "BANNER"))'
http-response-jq (?i)^https://www\.gaoding\.com/api/v\d/oc/exhibitions/(templates|all_editor_tools)/resources$ 'walk(if type == "object" and .badge_img_url? then .badge_img_url="" else . end)'
