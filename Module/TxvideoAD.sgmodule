#!name = 腾讯视频净化
#!author = TG@ZenMoFiShi
#!desc = 去除开屏广告、视频播放前广告、底部的多余 tap 栏、我的页面美化、我的界面顶部广告
# Converted from: https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/TxvideoAD.snippet

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
TxvideoAD-0 = type=http-request, pattern=^https?://i\.video\.qq\.com/(?:\?.*)?$, requires-body=true, binary-body-mode=true, max-size=1048576, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/Txvideoad.surge.js, timeout=10
TxvideoAD-1 = type=http-response, pattern=^https?://i\.video\.qq\.com/(?:\?.*)?$, requires-body=true, binary-body-mode=true, max-size=1048576, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/Txvideoad.surge.js, timeout=10
TxvideoAD-2 = type=http-response, pattern=^https?://iacc\.qq\.com/(?:\?.*)?$, requires-body=true, binary-body-mode=true, max-size=1048576, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/Txvideoad.surge.js, timeout=10
TxvideoAD-3 = type=http-response, pattern=^https?://config\.ab\.qq\.com/tab/GetTabRemoteConfig(?:\?.*)?$, requires-body=true, binary-body-mode=true, max-size=1048576, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/Txvideoad.surge.js, timeout=10
TxvideoAD-4 = type=http-response, pattern=^https://rdelivery\.qq\.com/v1/sdkconfig/get(?:\?.*)?$, requires-body=true, binary-body-mode=false, max-size=1048576, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/Txvideoad.surge.js, timeout=10

[MITM]
hostname = %APPEND% i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
