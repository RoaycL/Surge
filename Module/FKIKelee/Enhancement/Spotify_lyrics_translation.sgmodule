#!name=Spotify歌词增强
#!desc=将Spotify的外语歌词翻译为简体中文，并提供双语翻译支持。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!category=FKIKelee · 功能增强
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Spotify_lyrics_translation.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% api.spotify.com, spclient.wg.spotify.com

[Script]
fk-Spotify_lyrics_translation-0 = type=http-response, pattern="(?i)^https?://api\.spotify\.com/v1/tracks\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Spotify/Spotify_response.js, timeout=15
fk-Spotify_lyrics_translation-1 = type=http-request, pattern="(?i)^https?://spclient\.wg\.spotify\.com/color-lyrics/v2/track/(.+)\?(.*)format=json", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Spotify/Spotify_request.js, timeout=15
fk-Spotify_lyrics_translation-2 = type=http-request, pattern="(?i)^https?://spclient\.wg\.spotify\.com/color-lyrics/v2/track/\w+\?(.*)", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Spotify/Spotify_request.js, timeout=15
fk-Spotify_lyrics_translation-3 = type=http-response, pattern="(?i)^https?://spclient\.wg\.spotify\.com/color-lyrics/v2/track/(.+)\?(.*)format=json(.*)subtype=Translate", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Spotify/Translate_response.js, timeout=15
fk-Spotify_lyrics_translation-4 = type=http-response, pattern="(?i)^https?://spclient\.wg\.spotify\.com/color-lyrics/v2/track/\w+\?(.*)subtype=Translate", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Spotify/Translate_response.js, timeout=15
fk-Spotify_lyrics_translation-5 = type=http-response, pattern="(?i)^https?://spclient\.wg\.spotify\.com/color-lyrics/v2/track/(.+)\?(.*)format=json(.*)subtype=External", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Spotify/External_Lyrics_response.js, timeout=15
fk-Spotify_lyrics_translation-6 = type=http-response, pattern="(?i)^https?://spclient\.wg\.spotify\.com/color-lyrics/v2/track/\w+\?(.*)subtype=External", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Spotify/External_Lyrics_response.js, timeout=15
