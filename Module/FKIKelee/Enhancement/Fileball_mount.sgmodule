#!name=Fileball网盘挂载
#!desc=支持挂载阿里云盘、夸克网盘和PikPak网盘，点击下方署名查看使用方法。
#!author=小白脸
#!category=FKIKelee · 功能增强
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Fileball.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Fileball_mount.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% aliyun.example.com, quark.example.com, pikpak.example.com,

[Script]
fk-Fileball_mount-0 = type=http-request, pattern="(?i)^http://(aliyun|quark|pikpak)\.example\.com", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Fileball/Fileball_mount.js, timeout=15
