[MITM]
hostname = %APPEND% acs.m.taobao.com

[Map Local]
(?i)^https://acs\.m\.taobao\.com/gw/mtop\.tmall\.campus\.guide\.advertising\.config\.list/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://acs\.m\.taobao\.com/gw/mtop\.tmall\.campus\.ai\.agent\.assistant\.settings\.get/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://acs\.m\.taobao\.com/gw/mtop\.tmall\.campus\.guide\.delivering\.recall\.general\.data\.query/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://acs\.m\.taobao\.com/gw/mtop\.tmall\.campus\.guide\.app\.home\.pop\.get/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://acs\.m\.taobao\.com/gw/mtop\.tmall\.kangaroo\.core\.service\.route\.fixrespagerecommend/ 'reduce [["data","resultValue","data","normal-banner-resource-code"],["data","resultValue","data","feeds-channel-code"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://acs\.m\.taobao\.com/gw/mtop\.tmall\.campus\.guide\.app\.userprofile\.framework\.v\d/ 'del(.data.memberBenefit, .data.memberBenefitNew) | .data.moduleSorts |= map(select(. != "memberBenefit" and . != "memberBenefitNew"))'
