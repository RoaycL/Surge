[MITM]
hostname = %APPEND% acs.m.taobao.com

[Map Local]
(?i)^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.home\.welcome/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://acs\.m\.taobao\.com/gw/mtop\.damai\.mec\.popup\.get/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.user\.my\.content\.get/ 'reduce [["data","banner"],["data","performFilmVip","userProfitList"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.mypage\.feed/ 'reduce [["data","feedCard"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://acs\.m\.taobao\.com/gw/mtop\.damai\.mec\.aristotle\.get/ 'reduce [["data","data","top","keywords"]][] as $p (.; delpaths([$p]))'
