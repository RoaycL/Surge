(?i)^https://thor\.weidian\.com/warlock/recommend\.guessULike/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://thor\.weidian\.com/feedserver/feed\.similarRecFeeds/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://thor\.weidian\.com/faith/search\.hotRecShadowWord/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://thor\.weidian\.com/faith/search\.getProcessTopics/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
