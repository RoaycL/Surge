[Script]
fk-Weidian_remove_ads-0 = type=http-response, pattern="(?i)^https://thor\.weidian\.com/appconf/getAppConfig/", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Weidian/getAppConfig.js, timeout=15
fk-Weidian_remove_ads-1 = type=http-response, pattern="(?i)^https://thor\.weidian\.com/wgs/wallet\.query\.order\.entrance/", requires-body=true, max-size=4194304, binary-body-mode=true, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Weidian/wallet.js, timeout=15
