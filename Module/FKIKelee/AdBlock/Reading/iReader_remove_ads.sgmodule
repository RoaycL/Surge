#!name=掌阅去广告
#!desc=移除开屏广告、悬浮广告、弹窗广告、朗读音色广告及我的页面广告，移除各页面的横幅轮播图。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 阅读资讯
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/iReader.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/iReader_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, saad.ms.zhangyue.net, REJECT

[MITM]
hostname = %APPEND% webboot.zhangyue.com, ih2.ireader.com

[Map Local]
(?i)^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/zyapi/bookstore/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/bookstore/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/zybk/api/pop/index\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/zyapi/bookstore/user/mytab\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/zyboot/activity/mytab\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/zyam/app/app\.php\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/zybook4/iphone/u/p/api\.php\? 'reduce [["Splash"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://(webboot\.zhangyue\.com|ih2\.ireader\.com)/bookstore/read/visual/channel/list\? '.body.list |= map(select(.id | contains("ad_") | not))'
