#!name=KOOK去广告
#!desc=移除开屏广告、房间横幅推广、促销活动、精简发现页面频道及我的页面，移除底栏商城入口。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 社交社区
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KOOK.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/KOOK_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% m.kookapp.cn, www.kookapp.cn

[Map Local]
(?i)^https://www\.kookapp\.cn/api/v3/ad/config$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://www\.kookapp\.cn/api/v3/promotion/ongoing$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://(m|www)\.kookapp\.cn/api/v\d/user/settings$ 'reduce [["ad_banner"],["advertise_on_off"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://(m|www)\.kookapp\.cn/api/v\d/user/settings$ '(if try (getpath([]) | has("ios_mall_switch")) catch false then setpath(["ios_mall_switch"];false) else . end)'
http-response-jq (?i)^https://www\.kookapp\.cn/api/v3/discover/tab-list\? '.data.items |= map(select(.id == 472 or .id == 473 or .id == 475))'
