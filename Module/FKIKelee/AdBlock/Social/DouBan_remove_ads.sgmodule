#!name=豆瓣去广告
#!desc=移除开屏广告、各页面信息流广告、首页横幅、搜索填充词。此插件需要IPA签名方可使用，App Store用户请勿使用此插件，务必点击下方主页链接查看详细教程。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 社交社区
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DouBan.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/DouBan_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% api.douban.com, frodo.douban.com, m.douban.com

[Map Local]
(?i)^https://api\.douban\.com/v\d/app_ads/splash data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://frodo\.douban\.com/api/v\d/erebor/feed_ad data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://m\.douban\.com/rexxar/api/v\d/market/products/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://frodo\.douban\.com/api/v\d/movie/ad data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://frodo\.douban\.com/api/v\d/home_banner data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://frodo\.douban\.com/api/v\d/search/found_words data-type=text data="{}" status-code=200 header="Content-Type:application/json"
