[MITM]
hostname = %APPEND% api.chenlongtech.cn

[Map Local]
(?i)^https://api\.chenlongtech\.cn/v\d/friends/startInfo$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.chenlongtech\.cn/v\d/friends/indexBanner$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.chenlongtech\.cn/v\d/friends/getPopup data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.chenlongtech\.cn/v\d/friends/allPopUpConfig$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.chenlongtech\.cn/v\d/friends/advConf$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.chenlongtech\.cn/v\d/user/checkQTSheInsurance$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-Uki_remove_ads-0 = type=http-response, pattern="(?i)^https://api\.chenlongtech\.cn/v\d/lover/productList", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Uki/Uki_remove_ads.js, timeout=15
fk-Uki_remove_ads-1 = type=http-response, pattern="(?i)^https://api\.chenlongtech\.cn/v\d/friends/closeFriend/home", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Uki/Uki_remove_ads.js, timeout=15
fk-Uki_remove_ads-2 = type=http-response, pattern="(?i)^https://api\.chenlongtech\.cn/v\d/party/config$", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Uki/Uki_remove_ads.js, timeout=15
fk-Uki_remove_ads-3 = type=http-response, pattern="(?i)^https://api\.chenlongtech\.cn/v1/post/fetchSearchRecommend$", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Uki/Uki_remove_ads.js, timeout=15
