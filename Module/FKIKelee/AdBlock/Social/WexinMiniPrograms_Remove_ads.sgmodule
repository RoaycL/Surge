[Body Rewrite]
http-response-jq (?i)^https://mcsp\.cloudpnr\.com/api/miniapp/popular/T_MINIAPP$ 'reduce [["data"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://saas-ad\.cloudpnr\.com/huifuad-base-api/api/tactics/ad$ 'reduce [["data",0],["data",1],["data",2]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://rms\.meituan\.com/api/v1/rmsmina/c/queryShopPortalInfo\? 'reduce [["data","popUpWindows"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://chong\.qq\.com/tws/wxmobile/GetProduct4App\? 'del(.respInfo.reserveProductList) | .respInfo.shortcut |= map(select(.name != "充流量" and .name != "领话费券"))'
http-response-jq (?i)^https://chong\.qq\.com/tws/wxmobile4app/GetSecondProduct\? 'del(.respInfo.productList) | .respInfo.shortcut |= map(select(.name != "充流量" and .name != "领话费券"))'
http-response-jq (?i)^https://chong\.qq\.com/tws/usernumberinfo/GetUserInfo\? 'reduce [["data","request","number","markSeat","servicehallOperList"],["data","request","number","servicehallOperList"],["data","request","number","markSeat","servicehallFuncList"],["data","request","number","servicehallFuncList"]][] as $p (.; delpaths([$p]))'

