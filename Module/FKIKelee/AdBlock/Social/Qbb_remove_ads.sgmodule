#!name=亲宝宝去广告
#!desc=移除开屏广告、弹窗广告、广告下发、用户行为上报，精简搜索页、育儿页和我的页面，拦截商城页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 社交社区
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Qbb.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Qbb_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, apimall.qbb6.com, REJECT

[MITM]
hostname = %APPEND% api.qbb6.com, apicommunity.qbb6.com, apipt.qbb6.com, apiuser.qbb6.com, apimall.qbb6.com

[Map Local]
(?i)^https://api\.qbb6\.com/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.qbb6\.com/commons/main/tab/info/get\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://apicommunity\.qbb6\.com/community/recommend/user/get\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://apipt\.qbb6\.com/parenting/pt/home/post/card/get\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://apipt\.qbb6\.com/lib/search/hot/keys/v\d\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://apiuser\.qbb6\.com/user/member/info/get\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://apimall\.qbb6\.com/mall/v\d/goods/count\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://apimall\.qbb6\.com/mall/homepage/data/get/v\d$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-Qbb_remove_ads-0 = type=http-response, pattern="(?i)^https://api\.qbb6\.com/commons/self/button/group/get/v\d\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Qbb/my.js, timeout=15
fk-Qbb_remove_ads-1 = type=http-response, pattern="(?i)^https://apipt\.qbb6\.com/parenting/pt/homepage/get/v\d\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Qbb/homepage.js, timeout=15
