#!name=微博轻享版去广告
#!desc=移除开屏广告、时间线广告及评论区广告，移除发现页面横幅推广、最常访问、主页访客及热门视频，移除搜索填充词。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 社交社区
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weibo_intl.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Weibo_intl_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% bootpreload.uve.weibo.com, weibointl.api.weibo.cn, api.weibo.cn

[Map Local]
(?i)^https://bootpreload\.uve\.weibo\.com/v1/ad/preload$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.weibo\.cn/2/cardlist\?v_f=2 data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.weibo\.cn/2/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://weibointl\.api\.weibo\.cn/portal\.php\?a=get_searching_info data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://weibointl\.api\.weibo\.cn/portal\.php\?a=trends 'reduce [["data","banner"],["data","user_footprint"],["data","profile_accessrecord"],["data","native_content"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://weibointl\.api\.weibo\.cn/portal\.php\?a=trends '.data.discover |= map(select(.schema != "尊享会员"))'
http-response-jq (?i)^https://api\.weibo\.cn/2/statuses/friends/timeline$ 'reduce [["advertises"],["ad"],["ad_version_2_weibo"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://api\.weibo\.cn/2/statuses/friends/timeline$ '.statuses|=map(select(.ad_marked!=true))'
http-response-jq (?i)^https://api\.weibo\.cn/2/statuses/unread_hot_timeline$ 'reduce [["ad"],["ad_version_2_weibo"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://api\.weibo\.cn/2/statuses/unread_hot_timeline$ '.statuses|=map(select(.ad_marked!=true))'
http-response-jq (?i)^https://api\.weibo\.cn/2/comments/build_comments\? '.datas[].data.ad_from_comment? = true'
http-response-jq (?i)^https://api\.weibo\.cn/2/statuses/container_detail\? '.pageHeader.data.items |= (if . == null then [] else map(select(.data.itemid != "top_searching")) end)'
http-response-jq (?i)^https://api\.weibo\.cn/2/cardlist\?aid= '.cards |= map(select((.mblog?|(.ad_marked?|type=="boolean")and.ad_marked==true)or(.card_group?|type=="array"and any(.[]?;.mblog?|(.ad_marked?|type=="boolean")and.ad_marked==true))|not))'
http-response-jq (?i)^https://weibointl\.api\.weibo\.cn/portal\.php\? '.data.cards |= map(.items |= map(if .type == "personal_vip" then .right_text = "" else . end))'
