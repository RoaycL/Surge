#!name=最美壁纸去广告
#!desc=移除悬浮广告、横幅广告、轮播图广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 工具与智能设备
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/iWallBiZhi.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/iWallBiZhi_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% api.fzxhmy.com

[Map Local]
(?i)^https://api\.fzxhmy\.com/seek/trendingword\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.fzxhmy\.com/tone/trending\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-iWallBiZhi_remove_ads-0 = type=http-response, pattern="(?i)^https://api\.fzxhmy\.com/core/initialize\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/iWallBiZhi/core_initialize.js, timeout=15
fk-iWallBiZhi_remove_ads-1 = type=http-response, pattern="(?i)^https://api\.fzxhmy\.com/landing/initialize\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/iWallBiZhi/landing_initialize.js, timeout=15
fk-iWallBiZhi_remove_ads-2 = type=http-response, pattern="(?i)^https://api\.fzxhmy\.com/avatar/landing\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/iWallBiZhi/landing.js, timeout=15
