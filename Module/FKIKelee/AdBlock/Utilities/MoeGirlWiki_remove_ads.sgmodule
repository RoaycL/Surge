[MITM]
hostname = %APPEND% grpc.moegirl.org.cn

[Map Local]
(?i)^https://grpc\.moegirl\.org\.cn/moegirl\.moepad\.MoepadAppMetaService/GetAppInitialInfo$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://grpc\.moegirl\.org\.cn/moegirl\.moepad\.MoepadService/GetLaunchAdPage$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://grpc\.moegirl\.org\.cn/moegirl\.moepad\.MoepadService/GetFeedAdProbability$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
