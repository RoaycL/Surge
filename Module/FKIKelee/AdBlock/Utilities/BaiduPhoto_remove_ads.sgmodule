#!name=一刻相册去广告
#!desc=移除开屏广告、横幅广告和弹窗推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 工具与智能设备
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BaiduPhoto.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/BaiduPhoto_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% pan.baidu.com, mbd.baidu.com

[Map Local]
(?i)^https://pan\.baidu\.com/act/api/conf\?.*conf_key=youa_core_config_ios data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://pan\.baidu\.com/youai/material/v1/getbynavid\?.*nav_id=1 data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://mbd\.baidu\.com/ccs/v1/start/confsync\? 'reduce [["data","service","config","advertisement"],["data","service","config","youa","pm_config_ad"]][] as $p (.; delpaths([$p]))'
