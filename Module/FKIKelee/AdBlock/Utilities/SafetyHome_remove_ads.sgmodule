[Rule]
DOMAIN, ad.iot.360.cn, REJECT

[MITM]
hostname = %APPEND% app.home.360.cn

[Map Local]
(?i)^https://app\.home\.360\.cn/v1/config/custom_config data-type=text data="{}" status-code=200 header="Content-Type:application/json"
