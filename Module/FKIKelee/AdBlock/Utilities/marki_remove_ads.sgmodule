[MITM]
hostname = %APPEND% marki.markiapp.com, market-callback.markiapp.com

[Map Local]
(?i)^https://marki\.markiapp\.com/mkg/MomStats/getFlowWindowList$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://marki\.markiapp\.com/mkg/Advertising/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://marki\.markiapp\.com/mkg/MomStats/getIntegralAdv$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://market-callback\.markiapp\.com/adcenter/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
