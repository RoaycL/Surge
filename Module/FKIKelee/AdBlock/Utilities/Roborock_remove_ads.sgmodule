# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% cniot.roborock.com, api.roborock.com

[Map Local]
(?i)^https://cniot\.roborock\.com/api/v1/activity/banner/list$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cniot\.roborock\.com/api/v1/activity/latest$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://cniot\.roborock\.com/api/v1/app/theme/device/icon\? data-type=text data="" status-code=404 header="Content-Type:text/plain"

[Body Rewrite]
http-response-jq (?i)^https://api\.roborock\.com/v2/h5\.page\.item\.info\?id=4115$ '.data |= map(select(.title == "常用功能"))'
