#!name=快捷搜索
#!desc=为Safari提供快速切换搜索引擎的能力，在插件列表中点击此插件上的链接查看使用方法。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 工具与智能设备
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Safari.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/QuickSearch.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% duckduckgo.com

[URL Rewrite]
(?i)^https://duckduckgo\.com/\?q=bd\+([^&]+).+ https://www.baidu.com/s?wd=$1 307
(?i)^https://duckduckgo\.com/\?q=bdimg\+([^&]+).+ https://image.baidu.com/search/index?tn=baiduimage&word=$1 307
(?i)^https://duckduckgo\.com/\?q=gimg\+([^&]+).+ https://www.google.com/search?&tbm=isch&q=$1 307
(?i)^https://duckduckgo\.com/\?q=b\+([^&]+).+ https://www.bing.com/search?q=$1 307
(?i)^https://duckduckgo\.com/\?q=wk\+([^&]+).+ https://zh.wikipedia.org/wiki/$1 307
(?i)^https://duckduckgo\.com/\?q=qm\+([^&]+).+ https://www.qimai.cn/search/index/country/cn/search/$1 307
(?i)^https://duckduckgo\.com/\?q=gh\+([^&]+).+ https://github.com/search?q=$1 307
(?i)^https://duckduckgo\.com/\?q=(?!(?:bd|bdimg|gimg|b|wk|qm|gh)\+)([^&]+).+ https://www.google.com/search?q=$1 307
