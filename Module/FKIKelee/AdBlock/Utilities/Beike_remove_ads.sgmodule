#!name=贝壳找房去广告
#!desc=移除开屏广告、弹窗广告、悬浮广告、信息流推广、我家页面的装修推荐。移除我的页面的专属推荐、游戏入口、钱包入口。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 工具与智能设备
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Beike.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Beike_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% apps.api.ke.com

[Body Rewrite]
http-response-jq (?i)^https://apps\.api\.ke\.com/platform/shellapp/homepage/initData/mini\? 'reduce [["data","bootpage"],["data","bottom_bar_activity"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://apps\.api\.ke\.com/platform/shellapp/userCenter/info\? 'reduce [["data","islandModule"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://apps\.api\.ke\.com/platform/shellapp/userCenter/info\? 'del(.data.mainIcons.list[] | select(.indexKey == "coupon"))'
http-response-jq (?i)^https://apps\.api\.ke\.com/platform/shellapp/myhome/pagedetail\? '.data.moduleList |= map(select(.tab != "myHomeDecorV4"))'
http-response-jq (?i)^https://apps\.api\.ke\.com/platform/shellapp/homepage/feed\? '.data.list |= map(select(.cardType == "houseContainer" or .cardType == "houseV2" or .cardType == "houseV3" or .cardType == "rentHouseDiscount" or .cardType == "decorationCase"))'

[Map Local]
(?i)^https://apps\.api\.ke\.com/config/config/bootpage\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://apps\.api\.ke\.com/platform/shellapp/userCenter/feed\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://apps\.api\.ke\.com/config/config/getactivityconfig\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
