#!name=香港抖音去广告
#!desc=精简左右侧边栏、移除底栏切换，其余内容后续再完善。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 工具与智能设备
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TikTok.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/HKDouYin_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
AND, ((IP-CIDR, 101.126.58.201/32, no-resolve), (DEST-PORT, 6443)), REJECT
AND, ((IP-CIDR, 110.249.199.75/32, no-resolve), (DEST-PORT, 6443)), REJECT
AND, ((IP-CIDR, 111.225.147.191/32, no-resolve), (DEST-PORT, 6443)), REJECT
AND, ((IP-CIDR, 111.63.61.101/32, no-resolve), (DEST-PORT, 6443)), REJECT
AND, ((IP-CIDR, 220.243.141.0/32, no-resolve), (DEST-PORT, 6443)), REJECT
AND, ((OR, ((DOMAIN-SUFFIX, bytegecko.com), (DOMAIN-SUFFIX, byteeffecttos.com))), (DOMAIN-KEYWORD, ncdn)), REJECT

[MITM]
hostname = %APPEND% aweme.snssdk.com, api5-normal-m.amemv.com

[Map Local]
(?i)^https://api5-normal-lq\.amemv\.com/api/ad/ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)/api/ad/ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://zlink\.ugsdk\.cn/ad/ data-type=text data="" status-code=404 header="Content-Type:text/plain"

[Body Rewrite]
http-response-jq (?i)^https://((aweme\.snssdk\.com|api5-normal-m\.amemv\.com)|api5-normal-m\.amemv\.com)/aweme/homepage/sidebar_data/\? 'reduce [["data_map","recently_apps"],["data_map","recently_users"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)/aweme/homepage/render/\? 'reduce [["data","tab_config"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)/aweme/homepage/render/\? '.data.tab_list[]? |= (if .extra.side_bar.modules != null then .extra.side_bar.modules[]?.items[]? |= (if .data.first_page_module?.module_title == "常用功能" then .data={} else . end) else . end) | .data.tab_list |= map(if .extra.tab_list != null then .extra.tab_list |= map(select(.tab_id | IN("homepage_tablive", "homepage_follow", "homepage_hot_container"))) else . end) | .data.tab_list |= map(select(.extra.tab_list != null and (.extra.tab_list | length > 0)))'
http-response-jq (?i)^https://(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)/tfe/api/request_combine/v1/\?need_personal_recommend '(if try (getpath(["data","/service/settings/v3/","body","data","settings"]) | has("homepage_two_session_tab_skin_2025")) catch false then setpath(["data","/service/settings/v3/","body","data","settings","homepage_two_session_tab_skin_2025"];false) else . end) | (if try (getpath(["data","/service/settings/v3/","body","data","settings"]) | has("homepage_tab_skin_enable")) catch false then setpath(["data","/service/settings/v3/","body","data","settings","homepage_tab_skin_enable"];false) else . end)'
