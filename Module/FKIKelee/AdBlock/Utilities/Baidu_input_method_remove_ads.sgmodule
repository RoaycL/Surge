#!name=百度输入法去广告
#!desc=过滤百度输入法广告，替换个人主页随机图。
#!author=Keywos[https://github.com/Keywos]
#!category=FKIKelee · 去广告 · 工具与智能设备
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Baidu_input_method.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Baidu_input_method_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% imeres.baidu.com, mbd.baidu.com, mime.baidu.com

[Map Local]
(?i)^https?://mime\.baidu\.com/v5/start_screen_ads/list data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://mime\.baidu\.com/sapi/v1/lccorpus/(applist|pannellist) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://mime\.baidu\.com/sapi/v1/(circle/joinedlist|lccorpus/usercorpussync|aihelpactivity/aihelpresource) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://mime\.baidu\.com/commer/pocket_api/enterprise_list data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://mbd\.baidu\.com/ccs/v1/start/confsync\?appname=baidu_input data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://mime\.baidu\.com/v5/(fb/st\?logtype|(notiv3|cellloc_noti|noti_cloudswitch_noti)/info) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-Baidu_input_method_remove_ads-0 = type=http-response, pattern="(?i)^https?://mime\.baidu\.com/(imrobot/v1/pub/relation/get_robot_list|v5/custom_page/(layout|getdata))", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Baidu_input_method/Baidu_input_method_remove_ads.js, timeout=15
