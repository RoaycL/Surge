[MITM]
hostname = %APPEND% saas.hpplay.cn

[Map Local]
(?i)^https://saas\.hpplay\.cn/api/lebo-desk/endpoint/app-resource/app_home_pop_up data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://saas\.hpplay\.cn/api/lebo-desk/endpoint/app-resource/app_home_tips data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://saas\.hpplay\.cn/api/lebo-desk/endpoint/app-resource/app_index_operate2 data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://saas\.hpplay\.cn/api/lebo-rabbit/app-card/list data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://saas\.hpplay\.cn/api/lebo-desk/endpoint/app-resource/app-user-banner data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-TV_Assistant_remove_ads-0 = type=http-response, pattern="(?i)^https://saas\.hpplay\.cn/api/lebo-desk/endpoint/app-resource/app_tab_red_dot\?user-tag=1$", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/TV_Assistant/TV_Assistant_remove_ads.js, timeout=15
