[MITM]
hostname = %APPEND% gw.xiaocantech.com, web2.realtech-inc.com, sdk.1rtb.net

[Map Local]
(?i)^https://web2\.realtech-inc\.com/oss/xc-app-assets/configs/common/theme\.json data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://sdk\.1rtb\.net/sdk/req_ad\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gw\.xiaocantech\.com/g/pa data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
fk-XiaoCan_remove_ads-rewrite-request = type=http-request, pattern="(?:(?i)^https://gw\.xiaocantech\.com/rpc)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/XiaoCan_remove_ads-request.js, timeout=10
