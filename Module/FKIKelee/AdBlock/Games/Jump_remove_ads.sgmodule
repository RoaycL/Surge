#!name=Jump去广告
#!desc=移除Jump开屏广告
#!author=MoonYuki[https://github.com/MoonYuki]
#!category=FKIKelee · 去广告 · 游戏电竞
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Jump.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Jump_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, zlsdk.1rtb.net, REJECT
DOMAIN, jp.ad.gameley.com, REJECT
DOMAIN, toblog.ctobsnssdk.com, REJECT
DOMAIN, s3plus.meituan.net, REJECT
DOMAIN, images.pinduoduo.com, REJECT
DOMAIN, qh-material.taobao.com, REJECT
DOMAIN-SUFFIX, admobile.top, REJECT

[MITM]
hostname = %APPEND% switch.jumpvg.com

[Body Rewrite]
http-response-jq (?i)^https:?//switch.jumpvg.com/jump/getlaunchad/v2$ 'del(.data.adList)|.data.launchAd.showType=0'
http-response-jq (?i)^https:?//switch.jumpvg.com/jump/recommend/ad_conf$ '.data=[]'
