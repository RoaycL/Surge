#!name=米游社去广告
#!desc=移除开屏广告、搜索栏热搜及资讯、青少年模式弹窗。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 游戏电竞
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/miHoYoBBS.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/miHoYoBBS_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% bbs-api.miyoushe.com, bbs-api-ab.miyoushe.com

[Map Local]
(?i)^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getAppSplash$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getHotKeywordAndEvent$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://bbs-api-static\.miyoushe\.com/search/api/search/pre_keyword\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getAppStartupData$ 'reduce [["data","resp_map","/teenager/api/info"],["data","resp_map","/apihub/api/getAppConfig","data","get_app_config_response","config","is_show_teenager_mode_btn"],["data","resp_map","/apihub/api/getAppConfig","data","get_app_config_response","config","teenager_popup_freq_type"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://bbs-api(-ab)?\.miyoushe\.com/apihub/api/getAppConfig$ '(if try (getpath(["data","config"]) | has("teenager_popup_freq_type")) catch false then setpath(["data","config","teenager_popup_freq_type"];0) else . end) | (if try (getpath(["data","config"]) | has("is_show_teenager_mode_btn")) catch false then setpath(["data","config","is_show_teenager_mode_btn"];0) else . end)'
http-response-jq (?i)^https://bbs-api-ab\.miyoushe\.com/teenager/api/info$ '(if try (getpath(["data"]) | has("is_enabled")) catch false then setpath(["data","is_enabled"];false) else . end) | (if try (getpath(["data"]) | has("is_teenager")) catch false then setpath(["data","is_teenager"];false) else . end) | (if try (getpath(["data"]) | has("is_force")) catch false then setpath(["data","is_force"];false) else . end)'
