[MITM]
hostname = %APPEND% gw-cn.jiaoliuqu.com

[Body Rewrite]
http-response-jq (?i)^https://gw-cn\.jiaoliuqu\.com/mp-dolphin/v\d/rec/recByPositions\? '.info.data |= map(if .materials and (.materials | type) == "array" then .materials |= map(select(has("adPosition") | not)) else . end)'
http-response-jq (?i)^https://gw-cn\.jiaoliuqu\.com/mp-dolphin/v\d/rec/recByPositions\? '.info.data |= map(if .materials and (.materials | type) == "array" then .materials |= map(select((keys | length) != 2 or (keys | sort) != ["link", "pic"])) else . end)'
http-response-jq (?i)^https://gw-cn\.jiaoliuqu\.com/bbs/v5/Home/getHomePageModulesBySortV\d\? '(.info.data.modules_list // []) |= [.[] | [.[] | del(.relaction_title, .scrollow_contents)]] | (.info.data.top_fix_list // []) |= [.[] | del(.subtitle_list)]'

[Map Local]
(?i)^https://gw-cn\.jiaoliuqu\.com/taqu-homepage/v\d/Banner/getBannerByPositions\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gw-cn\.jiaoliuqu\.com/bbs/v5/Guide/photoGuide\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gw-cn\.jiaoliuqu\.com/i/v\d/homepage/completeGuideV\d\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gw-cn\.jiaoliuqu\.com/i/v\d/asset/toast\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gw-cn\.jiaoliuqu\.com/bbs/v5/Sign/getDailySigninInfoV4\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gw-cn\.jiaoliuqu\.com/taqu-hichat/v\d/Hichat/getRecommendInfo\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gw-cn\.jiaoliuqu\.com/live_api/v\d/Banner/getBannerListV\d\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gw-cn\.jiaoliuqu\.com/live_api/v\d/HallScroll/getList\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
