#!name=美丽修行去广告
#!desc=移除开屏广告、首页广告、发现页广告、美修盒页面广告、下拉广告、弹窗广告、搜索推广、版本更新弹窗及我的页面广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 健康生活
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Meizhixiuxing.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Meizhixiuxing_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% api.bevol.com

[Map Local]
(?i)^https://api\.bevol\.com/appmain/app/home/launch$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.bevol\.com/appmain/app/home/popup$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.bevol\.com/personal/page$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.bevol\.com/seach/foundAndTopSearch$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://api\.bevol\.com/appmain/app/home/page$ 'reduce [["result","versionPopUp"],["result","isShowSearchLabel"],["result","isShowSearchFeedBack"],["result","centerBannerAdvert"],["result","programmaticAdvertising"],["result","mattsData"],["result","questionnaireMap"],["result","appPullDownAdvert"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://api\.bevol\.com/appmain/app/home/feed$ 'reduce [["result","banners"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://api\.bevol\.com/appmain/app/home/feed$ '. | .result.returnList |= (map(select(.tname == "userPart"))) | .result.returnList |= map(select(. | has("adId") | not))'
http-response-jq (?i)^https://api\.bevol\.com/trialbox/shop/app/homePage$ 'reduce [["result","firstPersonActivity"],["result","mainActivity"],["result","brandZone"],["result","imageAD2"],["result","couponPopupInfo"]][] as $p (.; delpaths([$p]))'
