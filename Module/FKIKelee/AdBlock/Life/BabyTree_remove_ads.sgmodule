[Map Local]
^http://go\.babytree\.com/go_pregnancy/api/(index_activity/get_app_index_activity|sign/sign_h_5)\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^http://go\.babytree\.com/go_search/api/mobile_search_new/get_multi_search_default_keywords\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^http://m\.meitun\.com/newapi/router/topic/hometptf/feedRecommend data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^http://plough\.babytree\.com/plough\.do data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Rule]
URL-REGEX, "^http:\/\/pic08\.babytreeimg\.com\/knowledge\/2022\/0923\/\w+", REJECT

[MITM]
hostname = %APPEND% api.babytree.com, go.babytree.com

[Script]
fk-BabyTree_remove_ads-0 = type=http-response, pattern="(?i)^http://api\.babytree\.com/bafconfigcenter_intf/config/get\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/BabyTree/BabyTree_remove_ads.js, timeout=15
fk-BabyTree_remove_ads-1 = type=http-response, pattern="(?i)^http://go\.babytree\.com/go_pregnancy/api/(app_index/get_app_tab|cms_column/get_column_list|feeds/get_index_feeds_list|user/get_user_info)\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/BabyTree/BabyTree_remove_ads.js, timeout=15
fk-BabyTree_remove_ads-2 = type=http-response, pattern="(?i)^http://go\.babytree\.com/go_search/api/mobile_search_new/search_index", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/BabyTree/BabyTree_remove_ads.js, timeout=15
