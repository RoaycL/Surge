[MITM]
hostname = %APPEND% fcard.api.moji.com, vdo.api.moji.com, sns.api.moji.com, mme.api.moji.com, psnlz.api.moji.com

[Map Local]
(?i)^https://fcard\.api\.moji\.com/flycard/flyCard\? data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://vdo\.api\.moji\.com/shortvideo/card/subscribe$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://vdo\.api\.moji\.com/shortvideo/video/index_flow\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://vdo\.api\.moji\.com/shortvideo/video_user/hotGuyRcm\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://vdo\.api\.moji\.com/shortvideo/zone/follow_src_zone\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://sns\.api\.moji\.com/user/dynamic_v9/json/someone_interest\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://mme\.api\.moji\.com/json/entrance/list$ 'del(.entrance_region_res_list[] | select(.region_name == "皇冠区域" or .region_name == "banner区")) | .entrance_region_res_list[].entrance_res_list |= if . then map(select(.entrance_name | . != "墨迹钱包" and . != "墨圈")) else . end'
