[Rule]
DOMAIN, adui.tg.meitu.com, REJECT

[MITM]
hostname = %APPEND% api.posters.meitu.com

[Body Rewrite]
http-response-jq (?i)^https://api\.posters\.meitu\.com/common/init\.json 'reduce [["data","vip"]][] as $p (.; delpaths([$p]))'
