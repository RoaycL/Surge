#!name=蜻蜓FM去广告
#!desc=移除开屏广告、信息流广告、各类相关内容推荐，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 影音娱乐
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/QtingFM.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/QtingFM_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, ad.qtfm.cn, REJECT
DOMAIN, adlaunch.qtfm.cn, REJECT

[MITM]
hostname = %APPEND% app.qtfm.cn, entry.qtfm.cn, recpage-c.qtfm.cn, user.qtfm.cn, search.qtfm.cn, woqt2.qtfm.cn

[Map Local]
(?i)^https://app\.qtfm\.cn/recommendapi/v8/ai_assistant_point$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://app\.qtfm\.cn/m-bff/v1/signin/show_homepage_icon$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://app\.qtfm\.cn/recommendapi/v\d/emotion$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://search\.qtfm\.cn/v\d/keyword/default$ data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://app\.qtfm\.cn/m-bff/v1/user/task/play$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://app\.qtfm\.cn/m-bff/v\d/i_listen/guess_you_like\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://recpage-c\.qtfm\.cn/v\d/favorites$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://user\.qtfm\.cn/u\d/api/v\d/user/following_podcaster\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://entry\.qtfm\.cn/api/v\d/personal/\?carrier data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://search\.qtfm\.cn/v3/entry$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://woqt2\.qtfm\.cn/v2/userConfig\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://app\.qtfm\.cn/m-bff/v\d/signin/show_homepage_icon$ '(if try (getpath(["data"]) | has("display_icon")) catch false then setpath(["data","display_icon"];false) else . end)'
http-response-jq (?i)^https://app\.qtfm\.cn/recommendapi/v\d/hotpage\? '.data.head |= map(select(.type == "IconGrid")) | .data.feeds |= map(select(.type == "Channel" or .type == "Radio" or .type == "ListenListChannel"))'
http-response-jq (?i)^https://app\.qtfm\.cn/m-bff/v\d/channel/\d{6}/playpage/\d{8} 'reduce [["data","related_recommend"],["data","recommend_bar"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://app\.qtfm\.cn/m-bff/v\d/mylistenpage 'reduce [["data","banner"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://app\.qtfm\.cn/m-bff/v\d/subscribed_channels\? 'reduce [["data","recommends"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://app\.qtfm\.cn/m-bff/v1/channelpage/\d+$ 'reduce [["data","vip_recommend"],["data","recommend_delivery"]][] as $p (.; delpaths([$p]))'
