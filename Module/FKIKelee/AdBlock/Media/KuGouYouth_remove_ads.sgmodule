#!name=酷狗概念版去广告
#!desc=移除广告服务模块、播放器广告，精简乐库及搜索页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 影音娱乐
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KuGouYouth.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/KuGouYouth_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% gateway.kugou.com

[Map Local]
(?i)^https://gateway\.kugou\.com/ads\.service/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.kugou\.com/youth/v1/start_img/last\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.kugou\.com/ads\.gateway/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^http://mobilelog\.kugou\.com/adtrackconfig\.json$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.kugou\.com/youth/v1/experiment/get_params\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.kugou\.com/youth/api/user/v1/init\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.kugou\.com/youth/v2/activity/task_list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.kugou\.com/youth/v1/channel/tab_list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gateway\.kugou\.com/goddess/v1/content/biz_list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://gateway\.kugou\.com/youth/v1/yueku/tab\? '.data.responses |= map(select(.module == "new_song_publish" or .module == "song_rank"))'
