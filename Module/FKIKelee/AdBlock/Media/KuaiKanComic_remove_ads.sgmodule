[Script]
fk-KuaiKanComic_remove_ads-0 = type=http-response, pattern="(?i)^https://(cdn-)?api\.kkmh\.com/v\d/ironman/comic/recommend", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/KuaiKanComic/KuaiKanComic_remove_ads.js, timeout=15
fk-KuaiKanComic_remove_ads-1 = type=http-response, pattern="(?i)^https://(cdn-)?api\.kkmh\.com/v\d/ironman/discovery_v\d/tab_list_v\d", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/KuaiKanComic/KuaiKanComic_remove_ads.js, timeout=15
fk-KuaiKanComic_remove_ads-2 = type=http-response, pattern="(?i)^https://(cdn-)?social\.kkmh\.com/v\d/graph/homepage/comicVideo/v\d/configs", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/KuaiKanComic/KuaiKanComic_remove_ads.js, timeout=15
fk-KuaiKanComic_remove_ads-3 = type=http-response, pattern="(?i)^https://(cdn-)?social\.kkmh\.com/v\d/graph/unified_feed$", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/KuaiKanComic/KuaiKanComic_remove_ads.js, timeout=15
