(?i)^https://(cdn-)?topic\.kkmh\.com/gamecard/v\d/activityModule/userSignInInfo\?activitySignInConfigId data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?topic\.kkmh\.com/gamecard/v\d/activityModule/fetchButtonInfo\?buttonConfigId data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?topic\.kkmh\.com/gamecard/v\d/activityText/getUserActivityTextInfo\?activityTextConfigId data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?pay\.kkmh\.com/v\d/kb/comic_page_banner/detail data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?api\.kkmh\.com/v\d/business/fake_push/info data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?shop\.kkmh\.com/mbff/popup_administration/page_management_popup_administration$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?api\.kkmh\.com/v\d/business/mine/business_config data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?pay\.kkmh\.com/v\d/vip/banner_tip_list data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?pay\.kkmh\.com/v\d/vip/charge_tip_list data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://h5\.kuaikanmanhua\.com/v\d/kb/recharge_good/list_h5 data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://(cdn-)?pay\.kkmh\.com/v\d/kb/wallet data-type=text data="{}" status-code=200 header="Content-Type:application/json"
