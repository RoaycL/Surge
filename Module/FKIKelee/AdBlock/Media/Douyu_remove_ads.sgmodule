#!name=斗鱼去广告
#!desc=移除开屏、首页视频流、首页轮播图广告，移除直播间悬浮窗。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 影音娱乐
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Douyu.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Douyu_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
# NOTE: 修复上游误放在 Rule 段的重定向。

[Rule]
URL-REGEX, "^http:\/\/linkmicschedule\.douyucdn\.cn\/im_schedule\/im_gate_list", REJECT
AND, ((DEST-PORT, 18000), (PROTOCOL, STUN)), REJECT
DOMAIN, stun1.douyucdn.cn, REJECT
DOMAIN, stun1.qvb.qcloud.com, REJECT

[URL Rewrite]
^(http:\/\/)((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/(hlsh5p1\.douyucdn2\.cn)(.*) $1$5$6 307

[MITM]
hostname = %APPEND% rtbapi.douyucdn.cn, apiv2.douyucdn.cn, venus.douyucdn.cn

[Map Local]
(?i)^https://rtbapi\.douyucdn\.cn/japi/sign/app/getinfo data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://apiv2\.douyucdn\.cn/japi/entrance/roomRes/nc/m/list 'reduce [["data","pendant_a"],["data","entrance_d"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://venus\.douyucdn\.cn/venus/config/static/update.+keyCodeSet=flow_config '(if try (getpath([]) | has("greatGodGameSitterSwitch")) catch false then setpath(["greatGodGameSitterSwitch"];0) else . end) | (if try (getpath([]) | has("followMoreAnchorEntrance")) catch false then setpath(["followMoreAnchorEntrance"];0) else . end) | (if try (getpath([]) | has("sdklivebanner")) catch false then setpath(["sdklivebanner"];0) else . end) | (if try (getpath([]) | has("homeActFloatSwitch")) catch false then setpath(["homeActFloatSwitch"];0) else . end) | (if try (getpath([]) | has("bringGoodsSwitch")) catch false then setpath(["bringGoodsSwitch"];0) else . end) | (if try (getpath([]) | has("qqGameSwitch")) catch false then setpath(["qqGameSwitch"];0) else . end)'

[Script]
fk-Douyu_remove_ads-0 = type=http-response, pattern="(?i)^https://apiv2\.douyucdn\.cn/mgapi/livenc/home/getRecV3", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Douyu/Douyu_remove_ads.js, timeout=15
