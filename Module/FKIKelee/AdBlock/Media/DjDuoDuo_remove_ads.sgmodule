[MITM]
hostname = %APPEND% api.dianyinduoduo.com

[Script]
fk-DjDuoDuo_remove_ads-0 = type=http-response, pattern="(?i)^https://api\.dianyinduoduo\.com/v4/config\.php\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/DjDuoDuo/DjDuoDuo_remove_ads.js, timeout=15
