[MITM]
hostname = %APPEND% api.xiaoyuzhoufm.com

[Body Rewrite]
http-response-jq (?i)^https://api\.xiaoyuzhoufm\.com/v1/discovery-feed/list '.data |= map(select(.type != "DISCOVERY_HEADER" and .type != "DISCOVERY_BANNER"))'

[Map Local]
(?i)^https://api\.xiaoyuzhoufm\.com/v\d/flash data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.xiaoyuzhoufm\.com/v\d/ai data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.xiaoyuzhoufm\.com/v\d/search/get data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?://api\.xiaoyuzhoufm\.com/v\d/category data-type=text data="{}" status-code=200 header="Content-Type:application/json"
