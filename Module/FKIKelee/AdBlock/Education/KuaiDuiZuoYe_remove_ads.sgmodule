#!name=快对去广告
#!desc=移除开屏广告、横幅推广，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 教育办公
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KuaiDuiZuoYe.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/KuaiDuiZuoYe_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, adx.zuoyebang.com, REJECT

[MITM]
hostname = %APPEND% www.kuaiduizuoye.com, apivip.kuaiduizuoye.com

[Map Local]
(?i)^https://www\.kuaiduizuoye\.com/init/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://www\.kuaiduizuoye\.com/activity/init/checkappconfig$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://www\.kuaiduizuoye\.com/kdapi/conf/appbannersv3$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://www\.kuaiduizuoye\.com/kdapi/conf/initbanner$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://apivip\.kuaiduizuoye\.com/viponline/scancode/mycard$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://www\.kuaiduizuoye\.com/codesearch/aid/home$ 'reduce [["data","homeBannerList"]][] as $p (.; delpaths([$p]))'
