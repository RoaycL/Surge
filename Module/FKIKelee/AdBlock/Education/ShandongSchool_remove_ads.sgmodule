(?i)^https://api\.huachenjie\.com/run-front/street/listThemeBanner$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.huachenjie\.com/run-front/api/home/activityEntry$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://api\.huachenjie\.com/run-front/home/promoSlots/config$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
