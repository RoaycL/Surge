[Body Rewrite]
http-response-jq (?i)^https://api\.huachenjie\.com/run-front/home/homePage/config$ '.data.functionEntries |= map(select(.name == "运动" or .name == "空间")) | del(.data.seaview)'
http-response-jq (?i)^https://api\.huachenjie\.com/run-front/api/user/cs/index$ 'reduce [["data","bannerList"]][] as $p (.; delpaths([$p]))'
http-response-jq (?i)^https://api\.huachenjie\.com/run-front/common/bottom-bar/redDot$ 'reduce [["data","inspiration"]][] as $p (.; delpaths([$p]))'
