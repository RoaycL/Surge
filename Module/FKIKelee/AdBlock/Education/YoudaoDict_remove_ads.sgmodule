#!name=网易有道词典去广告
#!desc=移除开屏广告、弹窗广告、右上角推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 教育办公
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YoudaoDict.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/YoudaoDict_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
# NOTE: 修复上游裸域名规则为 DOMAIN REJECT。

[Rule]
DOMAIN,ad-sdk-config.youdao.com,REJECT

[MITM]
hostname = %APPEND% dict.youdao.com

[Body Rewrite]
http-response-jq (?i)^https://dict\.youdao\.com/homepage/toolbar/get/ 'reduce [["data","vipTag"]][] as $p (.; delpaths([$p]))'

[Map Local]
(?i)^https://dict\.youdao\.com/vip/activity/startup/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://dict\.youdao\.com/vip/activity/retention/configs\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://dict\.youdao\.com/vip/activity/retention/match\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://dict\.youdao\.com/vip/user/paid/guide\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
