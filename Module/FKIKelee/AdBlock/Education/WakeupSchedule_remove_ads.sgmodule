[MITM]
hostname = %APPEND% api.wakeup.fun

[Map Local]
(?i)^https://api\.wakeup\.fun/wakeup/app/bannerconf$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://api\.wakeup\.fun/wakeup/user/mine$ 'reduce [["data","bannerItems"]][] as $p (.; delpaths([$p]))'
