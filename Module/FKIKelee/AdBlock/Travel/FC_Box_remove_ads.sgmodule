#!name=丰巢去广告
#!desc=移除弹窗，精简首页和生活服务。此插件需要IPA签名方可使用，App Store用户请勿使用此插件，务必点击下方主页链接查看详细教程。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 出行汽车
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/FC_Box.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/FC_Box_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% consumer.fcbox.com, dsp.fcbox.com

[Map Local]
(?i)^https://consumer\.fcbox\.com/fcboxactivityweb/api/v\d/clientPage/modulesAggregated\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://consumer\.fcbox\.com/fcboxactivityweb/api/v\d/clientPage/jinGangFirst\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://consumer\.fcbox\.com/v2/home/mallInfo$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://dsp\.fcbox\.com/adSearch/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://consumer\.fcbox\.com/hs-portal/app/config/page/home/v2\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://consumer\.fcbox\.com/post/suggestion/query$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://consumer\.fcbox\.com/fcboxactivityweb/marketingEntrance/retentionPopup$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://consumer\.fcbox\.com/fcboxactivityweb/api/clientPopup/v\d/queryPopupWithPriority$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://consumer\.fcbox\.com/fcboxactivityweb/api/guidePopup/popup$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)^https://consumer\.fcbox\.com/v1/dynamicConfig/findTabbarConfig/mainPage$ 'reduce [["data","lifeService"],["data","mall"],["data","wash"]][] as $p (.; delpaths([$p]))'
