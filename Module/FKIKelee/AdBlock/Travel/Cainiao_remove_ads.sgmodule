# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Cainiao_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% netflow-mtop.cainiao.com, nbcps-mtop.cainiao.com, cn-acs.m.cainiao.com, e2e-mtop.cainiao.com, longquan-mtop.cainiao.com

[Map Local]
(?i)^https://nbcps-mtop\.cainiao\.com/gw/mtop\.cainiao\.nbcps\.presentation\.fetch\.cn data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://netflow-mtop\.cainiao\.com/gw/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.index data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://cn-acs\.m\.cainiao\.com/gw/mtop\.cainiao\.adkeyword\.get\.cn data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://cn-acs\.m\.cainiao\.com/gw/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.m?show data-type=text data="" status-code=404 header="Content-Type:text/plain"

[Body Rewrite]
http-response-jq (?i)^https://(cn-acs\.m|e2e-mtop)\.cainiao\.com/gw/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch 'del(.data.data.data.mainSearch.bizData.searchContents, .data.data.data.operationList)'
http-response-jq (?i)^https://e2e-mtop\.cainiao\.com/gw/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch\.cn 'del(.data.data.banner, .data.data.activity, .data.data.vip)'
http-response-jq (?i)^https://longquan-mtop\.cainiao\.com/gw/mtop\.com\.cainiao\.longquan\.place\.getpageresourcecontent\.cn 'del(.data.result.placeContentMap["780001"].contentList)'
http-response-jq (?i)^https://netflow-mtop\.cainiao\.com/gw/mtop\.cainiao\.guoguo\.nbnetflow\.ads 'if .data.result[0].materialId == "39017" then . else .data = {} end'
