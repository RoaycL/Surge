#!name=车来了去广告
#!desc=清洗配置，移除开屏广告、首页金刚位、文章推荐，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 出行汽车
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chelaile.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/Chelaile_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[Rule]
DOMAIN, ad.chelaile.net.cn, REJECT
URL-REGEX,"(?i)^https://image3\.chelaile\.net\.cn/hw6u6LYY\.png$",REJECT-TINYGIF

[MITM]
hostname = %APPEND% api.chelaile.net.cn, web.chelaile.net.cn, cdn.web.chelaile.net.cn, image3.chelaile.net.cn

[Map Local]
(?i)^https://cdn\.web\.chelaile\.net\.cn/info-flow/index\.html\? data-type=text data="" status-code=404 header="Content-Type:text/plain"

[Script]
fk-Chelaile_remove_ads-rewrite-response = type=http-response, pattern="(?:(?i)^https://api\.chelaile\.net\.cn/goocity/flowPos/home\?)|(?:(?i)^https://api\.chelaile\.net\.cn/goocity/flowPos/listByPos\?)|(?:(?i)^https://web\.chelaile\.net\.cn/api/operative_position/infoflow/getInfo\?)|(?:(?i)^https://api\.chelaile\.net\.cn/led-weather/v\d/condition_brief\?)|(?:(?i)^https://api\.chelaile\.net\.cn/goocity/config/notices\?)|(?:(?i)^https://api\.chelaile\.net\.cn/encourage/activity/control\?)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/Chelaile_remove_ads-response.js, timeout=10
fk-Chelaile_remove_ads-0 = type=http-response, pattern="(?i)^https://api\.chelaile\.net\.cn/bus-side/appToggle/getStatus\?", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/Chelaile/Chelaile_remove_ads.js, timeout=15
