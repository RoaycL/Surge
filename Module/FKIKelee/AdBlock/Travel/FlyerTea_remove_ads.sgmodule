#!name=飞客去广告
#!desc=移除开屏广告、首页广告、板块广告、帖内广告和我的页面广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 去广告 · 出行汽车
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/FlyerTea.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/FlyerTea_remove_ads.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% www.flyert.com.cn, ptf.flyertrip.com

[Map Local]
(?i)^https://www\.flyert\.com\.cn/api/mobile/index\.php\?module=advis data-type=text data="" status-code=404 header="Content-Type:text/plain"
(?i)^https://www\.flyert\.com\.cn/api/mobile/index\.php\?module=vip_coupon data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://www\.flyert\.com\.cn/api/mobile/index\.php\?module=getdata data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Rule]
URL-REGEX,"(?i)^https://ptf\.flyertrip\.com/static/img/common/ic_plate_mine_button\.png",REJECT-TINYGIF

[Script]
fk-FlyerTea_remove_ads-0 = type=http-response, pattern="(?i)^https://www\.flyert\.com\.cn/api/mobile/index\.php\?version=5", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/FlyerTea/FlyerTea_remove_ads.js, timeout=15
fk-FlyerTea_remove_ads-1 = type=http-response, pattern="(?i)^https://www\.flyert\.com\.cn/api/mobile/index\.php\?module=plugin&id=k_misign:sign", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/FlyerTea/FlyerTea_remove_ads.js, timeout=15
