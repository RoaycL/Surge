[MITM]
hostname = %APPEND% richmanrules.ksedt.com, gouche.ksedt.com, muses.ksedt.com, op.ksedt.com, api.ksedt.com

[Map Local]
(?i)^https://richmanrules\.ksedt\.com/serverConfig/3/adConfig\.json data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://gouche\.ksedt\.com/config/popup/info$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://richmanrules\.ksedt\.com/intellectWaterfallBidding/find$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://op\.ksedt\.com/jxedtLive/liveIntroduceResource data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://richmanrules\.ksedt\.com/intellectWaterfall/find$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
http-response-jq (?i)http-response 'reduce [["^https://api\\","ksedt\\","com/api/config/"]][] as $p (.; delpaths([$p]))'
