#!name=代理链路检测
#!desc=查看目标节点的代理走向，在插件列表中点击此插件上的链接查看使用方法。
#!author=I-am-R-E[https://github.com/I-am-R-E]
#!category=FKIKelee · 节点检测
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Stack.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/NodeLinkCheck.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.
#!arguments=policy:DIRECT
#!arguments-desc=policy：Surge 节点/策略名称，替代 Loon 长按节点。

[Script]
fk-NodeLinkCheck-0 = type=generic, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Adapters/kelee/JavaScript/NodeLinkCheck/NodeLinkCheck.js, timeout=15, argument="__policy={{{policy}}}"

[Panel]
代理链路检测-0 = script-name=fk-NodeLinkCheck-0,update-interval=-1
