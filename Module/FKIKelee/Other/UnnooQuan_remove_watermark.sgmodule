#!name=知识星球去水印
#!desc=移除内容的水印编号
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=FKIKelee · 其他
#!homepage=https://github.com/RoaycL/Surge/tree/main/Module/FKIKelee
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/UnnooQuan.png
# Source: https://github.com/RoaycL/fkikelee/blob/9dd6685421381eb055332b15cefa4d31f199da5a/lpx/UnnooQuan_remove_watermark.lpx
# Generated by scripts/convert_loon.py; original authors retain attribution.

[MITM]
hostname = %APPEND% api.zsxq.com

[Body Rewrite]
http-response-jq (?i)^https://api\.zsxq\.com/v2/groups/\d+$ '(if try (getpath(["resp_data","group","policies"]) | has("enable_watermark")) catch false then setpath(["resp_data","group","policies","enable_watermark"];false) else . end)'

[Script]
fk-UnnooQuan_remove_watermark-rewrite-response = type=http-response, pattern="(?:(?i)^https://articles\.zsxq\.com/inline_form/id_[a-z0-9]+\.html)", requires-body=true, max-size=4194304, script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/JS/FKIKelee/Rewrite/UnnooQuan_remove_watermark-response.js, timeout=10
