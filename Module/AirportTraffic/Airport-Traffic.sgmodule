#!name=机场流量概况
#!desc=在 Surge Panel 中显示最多 5 个机场的流量与套餐到期信息。每个订阅链接均有独立编辑栏，直接粘贴原始链接，无需 URL Encode。
#!arguments=机场1:"",机场2:"",机场3:"",机场4:"",机场5:""
#!arguments-desc=每个参数对应一个机场订阅链接，直接粘贴原始链接，无需 URL Encode。留空的机场不会启用。

[Panel]
机场 1 = script-name=airport-traffic-1,update-interval=3600
机场 2 = script-name=airport-traffic-2,update-interval=3600
机场 3 = script-name=airport-traffic-3,update-interval=3600
机场 4 = script-name=airport-traffic-4,update-interval=3600
机场 5 = script-name=airport-traffic-5,update-interval=3600

[Script]
airport-traffic-1 = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/Module/AirportTraffic/airport-traffic.js,argument="title=机场 1&url={{{机场1}}}"
airport-traffic-2 = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/Module/AirportTraffic/airport-traffic.js,argument="title=机场 2&url={{{机场2}}}"
airport-traffic-3 = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/Module/AirportTraffic/airport-traffic.js,argument="title=机场 3&url={{{机场3}}}"
airport-traffic-4 = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/Module/AirportTraffic/airport-traffic.js,argument="title=机场 4&url={{{机场4}}}"
airport-traffic-5 = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/Module/AirportTraffic/airport-traffic.js,argument="title=机场 5&url={{{机场5}}}"
