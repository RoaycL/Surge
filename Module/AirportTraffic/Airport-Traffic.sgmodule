#!name=机场流量概况
#!desc=在 Surge Panel 中显示最多 5 个机场的流量、重置日期与套餐到期日。订阅链接可直接粘贴原始地址，无需 URL Encode。
#!arguments=机场1开关:"airport-traffic-1",机场1链接:"",机场1名称:"机场 1",机场1重置日:"",机场1到期日:"",机场2开关:"airport-traffic-2",机场2链接:"",机场2名称:"机场 2",机场2重置日:"",机场2到期日:"",机场3开关:"airport-traffic-3",机场3链接:"",机场3名称:"机场 3",机场3重置日:"",机场3到期日:"",机场4开关:"#airport-traffic-4",机场4链接:"",机场4名称:"机场 4",机场4重置日:"",机场4到期日:"",机场5开关:"#airport-traffic-5",机场5链接:"",机场5名称:"机场 5",机场5重置日:"",机场5到期日:""
#!arguments-desc=每个机场有 5 个独立参数：开关、链接、名称、重置日、到期日。\n\n开关：启用时填写 airport-traffic-N，禁用时在前面加 #。例如机场 4：airport-traffic-4 为启用，#airport-traffic-4 为隐藏。默认启用机场 1-3，隐藏机场 4-5。\n\n链接：直接粘贴原始订阅链接，无需 URL Encode。\n名称：面板标题。\n重置日：填写 1-31；终身套餐若仍按月重置，照常填写；若永不重置则留空。\n到期日：填写 YYYY-MM-DD；留空时尝试自动读取；终身套餐填写 永久；填写 false 则隐藏。

[Panel]
{{{机场1开关}}} = script-name=airport-traffic-1,update-interval=3600
{{{机场2开关}}} = script-name=airport-traffic-2,update-interval=3600
{{{机场3开关}}} = script-name=airport-traffic-3,update-interval=3600
{{{机场4开关}}} = script-name=airport-traffic-4,update-interval=3600
{{{机场5开关}}} = script-name=airport-traffic-5,update-interval=3600

[Script]
{{{机场1开关}}} = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/RoaycL/Surge/7f9d7775c4f298451435f98f9e44e5da8f1fcb90/Module/AirportTraffic/airport-traffic.js,argument="title={{{机场1名称}}}&reset_day={{{机场1重置日}}}&expire={{{机场1到期日}}}&url={{{机场1链接}}}"
{{{机场2开关}}} = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/RoaycL/Surge/7f9d7775c4f298451435f98f9e44e5da8f1fcb90/Module/AirportTraffic/airport-traffic.js,argument="title={{{机场2名称}}}&reset_day={{{机场2重置日}}}&expire={{{机场2到期日}}}&url={{{机场2链接}}}"
{{{机场3开关}}} = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/RoaycL/Surge/7f9d7775c4f298451435f98f9e44e5da8f1fcb90/Module/AirportTraffic/airport-traffic.js,argument="title={{{机场3名称}}}&reset_day={{{机场3重置日}}}&expire={{{机场3到期日}}}&url={{{机场3链接}}}"
{{{机场4开关}}} = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/RoaycL/Surge/7f9d7775c4f298451435f98f9e44e5da8f1fcb90/Module/AirportTraffic/airport-traffic.js,argument="title={{{机场4名称}}}&reset_day={{{机场4重置日}}}&expire={{{机场4到期日}}}&url={{{机场4链接}}}"
{{{机场5开关}}} = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/RoaycL/Surge/7f9d7775c4f298451435f98f9e44e5da8f1fcb90/Module/AirportTraffic/airport-traffic.js,argument="title={{{机场5名称}}}&reset_day={{{机场5重置日}}}&expire={{{机场5到期日}}}&url={{{机场5链接}}}"
