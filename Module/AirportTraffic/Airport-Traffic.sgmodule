#!name=机场流量概况
#!desc=在 Surge Panel 中显示最多 5 个机场的流量、重置日期与套餐到期日。订阅链接可直接粘贴原始地址，无需 URL Encode。
#!arguments=机场1名称:"#",机场1链接:"",机场1重置日:"",机场1到期日:"",机场2名称:"#",机场2链接:"",机场2重置日:"",机场2到期日:"",机场3名称:"#",机场3链接:"",机场3重置日:"",机场3到期日:"",机场4名称:"#",机场4链接:"",机场4重置日:"",机场4到期日:"",机场5名称:"#",机场5链接:"",机场5重置日:"",机场5到期日:""
#!arguments-desc=名称同时作为启用开关：填写机场名称即启用并作为面板标题；填写 # 即隐藏。新安装默认全部隐藏。多个机场请使用不同名称。\n\n链接：直接粘贴原始订阅链接，无需 URL Encode。\n重置日：填写 1-31；终身套餐若仍按月重置，照常填写；若永不重置则留空。\n到期日：填写 YYYY-MM-DD、YYYY.MM.DD 或 永久；留空时尝试自动读取；填写 false 则隐藏。

[Panel]
{{{机场1名称}}} = script-name=airport-traffic-1,update-interval=3600
{{{机场2名称}}} = script-name=airport-traffic-2,update-interval=3600
{{{机场3名称}}} = script-name=airport-traffic-3,update-interval=3600
{{{机场4名称}}} = script-name=airport-traffic-4,update-interval=3600
{{{机场5名称}}} = script-name=airport-traffic-5,update-interval=3600

[Script]
airport-traffic-1 = type=generic,timeout=15,script-update-interval=0,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/Module/AirportTraffic/airport-traffic.js,argument="title={{{机场1名称}}}&reset_day={{{机场1重置日}}}&expire={{{机场1到期日}}}&url={{{机场1链接}}}"
airport-traffic-2 = type=generic,timeout=15,script-update-interval=0,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/Module/AirportTraffic/airport-traffic.js,argument="title={{{机场2名称}}}&reset_day={{{机场2重置日}}}&expire={{{机场2到期日}}}&url={{{机场2链接}}}"
airport-traffic-3 = type=generic,timeout=15,script-update-interval=0,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/Module/AirportTraffic/airport-traffic.js,argument="title={{{机场3名称}}}&reset_day={{{机场3重置日}}}&expire={{{机场3到期日}}}&url={{{机场3链接}}}"
airport-traffic-4 = type=generic,timeout=15,script-update-interval=0,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/Module/AirportTraffic/airport-traffic.js,argument="title={{{机场4名称}}}&reset_day={{{机场4重置日}}}&expire={{{机场4到期日}}}&url={{{机场4链接}}}"
airport-traffic-5 = type=generic,timeout=15,script-update-interval=0,script-path=https://raw.githubusercontent.com/RoaycL/Surge/main/Module/AirportTraffic/airport-traffic.js,argument="title={{{机场5名称}}}&reset_day={{{机场5重置日}}}&expire={{{机场5到期日}}}&url={{{机场5链接}}}"
