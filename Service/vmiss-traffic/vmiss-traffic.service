[Unit]
Description=VMISS traffic API (vnstat)
After=network-online.target vnstat.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/vmiss-traffic.env
ExecStart=/usr/bin/python3 /opt/vmiss-traffic/server.py
User=vnstat
Group=vnstat
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
