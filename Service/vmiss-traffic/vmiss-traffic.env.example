# /etc/vmiss-traffic.env  (mode 600, read by systemd)
VMISS_TOKEN=change-me
VMISS_IFACE=eth0
VMISS_PORT=8890
# Used only when the panel does not send its own reset day / UTC offset.
VMISS_RESET_DAY=23
VMISS_UTC_OFFSET=-5
# Traffic already used in the running period before vnstat started, and when
# vnstat started (ISO time). Counted only for the period containing that moment.
VMISS_BASE_BYTES=0
VMISS_BASE_AT=
