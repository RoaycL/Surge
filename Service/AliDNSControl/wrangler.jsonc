{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alidns-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "alidns.roayc.com", "custom_domain": true }],
  "vars": { "PUBLIC_ORIGIN": "https://alidns.roayc.com" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/client/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "CONTROL", "class_name": "QuotaControl" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaControl"] }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
  },
}
